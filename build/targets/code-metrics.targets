<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Code metrics targets for AltCover instrumentation and coverage collection -->

  <!-- Set ErrorLog (SARIF) -->
  <Target Name="SetSarifErrorLog" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' and '$(SarifMetricsEnabled)' == 'true' and '$(MSBuildProjectName)' != 'SourceHashGenerator'">
    <PropertyGroup>
      <ErrorLog>$(SarifOutputDir)\$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
    </PropertyGroup>
  </Target>

  <!-- Ensure metrics directories exist before compilation (only for SARIF, as it needs ErrorLog during compilation) -->
  <Target Name="PrepareMetricsDirectories" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' != 'SourceHashGenerator'">
    <!-- Ensure Sarif directory exists for compiler-generated SARIF files -->
    <MakeDir Condition="'$(SarifMetricsEnabled)' == 'true'" Directories="$(SarifOutputDir)" />
    <!-- Ensure AltCover directory exists -->
    <MakeDir Condition="'$(AltCoverEnabled)' == 'true'" Directories="$(AltCoverOutputDir)" />
    <!-- Roslyn directory is created only when needed in GenerateSolutionMetrics to avoid blocking parallel builds -->
  </Target>

  <!-- Generate Roslyn metrics for entire solution (runs once for Rca.MetricsReporter.Tests after all projects are built) -->
  <!-- Metrics.exe will use already built projects or build them if needed -->
  <Target Name="GenerateSolutionMetrics" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(RoslynMetricsEnabled)' == 'true' and '$(MSBuildProjectName)' == 'Rca.MetricsReporter.Tests'">
    <MakeDir Directories="$(RoslynOutputDir)" />
    <Exec Command='"$(RoslynMetricsToolExe)" /solution:"$(RoslynMetricsSolutionPath)" /out:"$(RoslynSolutionMetricsOutputFile)" /quiet'
          WorkingDirectory="$(RoslynMetricsToolDir)"
          IgnoreExitCode="false" />
  </Target>

  <!-- Intermediate gate that waits for deployment targets to complete -->
  <Target Name="WaitForAllDeployments"
          AfterTargets="Build"
          DependsOnTargets="DeployLoaderGroup;DeployRuntimeGroup"
          Condition="'$(AltCoverEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    
    <Message Text="Deployment targets completed, proceeding to instrumentation" Importance="Normal" />
  </Target>

  <!-- Instrument deployed assemblies with AltCover after all deployment targets have completed -->
  <Target Name="InstrumentDeployedAssemblies"
          AfterTargets="WaitForAllDeployments"
          Condition="'$(AltCoverEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Rca.Runtime' and '$(RuntimeDeployDir)' != '' and Exists('$(RuntimeDeployDir)')">
    <PropertyGroup>
      <AltCoverInputDir>$(RuntimeDeployDir)</AltCoverInputDir>
      <!-- Method filter to exclude constructors (ctor) and static constructors (cctor) from coverage -->
      <AltCoverMethodFilter Condition="'$(AltCoverMethodFilter)' == ''">.cctor|.ctor</AltCoverMethodFilter>
      <!-- Test output configuration used for copying instrumented assemblies into unit test bin directories -->
      <RcaTestTargetFramework Condition="'$(RcaTestTargetFramework)' == ''">net8.0-windows</RcaTestTargetFramework>
      <!-- AltCover backup directory (removed before each run to keep instrumentation idempotent) -->
      <AltCoverSavedDir>$(AltCoverInputDir)\__Saved</AltCoverSavedDir>
    </PropertyGroup>

    <!-- Run AltCover instrumentation in-place -->
    <!-- Using direct command execution instead of PowerShell wrapper for better parameter handling -->
    <!-- Remove previous AltCover backup directory if it exists to avoid tool usage errors on repeated runs -->
    <RemoveDir Directories="$(AltCoverSavedDir)" Condition="Exists('$(AltCoverSavedDir)')" />

    <Message Text="Instrumenting assemblies in $(AltCoverInputDir) with AltCover" Importance="High" />
    <Exec Command='altcover --inputDirectory="$(AltCoverInputDir)" --assemblyFilter="$(RcaCoverageAssemblyFilter)" --methodFilter="$(AltCoverMethodFilter)" --inplace --save --report="$(RcaCoverageOutputFile)"' 
          ContinueOnError="false" />
    <Message Text="AltCover instrumentation completed. Signal file: $(AltCoverSignalFile)" Importance="Normal" />
  </Target>

  <!-- Copy instrumented runtime assemblies into unit test output directories after all tests are built -->
  <!-- Anchored on Rca.Core.Tests, which in current graph builds last among test projects -->
  <Target Name="CopyInstrumentedAssembliesToTests"
          AfterTargets="Build"
          Condition="'$(AltCoverEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Rca.Core.Tests' and '$(RuntimeDeployDir)' != '' and Exists('$(RuntimeDeployDir)')">
    <PropertyGroup>
      <!-- Ensure AltCoverInputDir is aligned with RuntimeDeployDir used during instrumentation -->
      <AltCoverInputDir Condition="'$(AltCoverInputDir)' == ''">$(RuntimeDeployDir)</AltCoverInputDir>
      <RcaTestTargetFramework Condition="'$(RcaTestTargetFramework)' == ''">net8.0-windows</RcaTestTargetFramework>

      <!-- Rca.Contracts -->
      <_ContractsTestBinDir>$(SolutionDir)tests\Rca.Contracts.Tests\bin\$(Configuration)\$(RcaTestTargetFramework)</_ContractsTestBinDir>
      <_ContractsTestDll>$(_ContractsTestBinDir)\Rca.Contracts.dll</_ContractsTestDll>
      <_ContractsTestPdb>$(_ContractsTestBinDir)\Rca.Contracts.pdb</_ContractsTestPdb>
      <_ContractsInstrumentedDll>$(AltCoverInputDir)\Rca.Contracts.dll</_ContractsInstrumentedDll>

      <!-- Rca.Core -->
      <_CoreTestBinDir>$(SolutionDir)tests\Rca.Core.Tests\bin\$(Configuration)\$(RcaTestTargetFramework)</_CoreTestBinDir>
      <_CoreTestDll>$(_CoreTestBinDir)\Rca.Core.dll</_CoreTestDll>
      <_CoreTestPdb>$(_CoreTestBinDir)\Rca.Core.pdb</_CoreTestPdb>
      <_CoreInstrumentedDll>$(AltCoverInputDir)\Rca.Core.dll</_CoreInstrumentedDll>

      <!-- Rca.Loader -->
      <_LoaderTestBinDir>$(SolutionDir)tests\Rca.Loader.Tests\bin\$(Configuration)\$(RcaTestTargetFramework)</_LoaderTestBinDir>
      <_LoaderTestDll>$(_LoaderTestBinDir)\Rca.Loader.dll</_LoaderTestDll>
      <_LoaderTestPdb>$(_LoaderTestBinDir)\Rca.Loader.pdb</_LoaderTestPdb>
      <_LoaderInstrumentedDll>$(AltCoverInputDir)\Rca.Loader.dll</_LoaderInstrumentedDll>

      <!-- Rca.Network -->
      <_NetworkTestBinDir>$(SolutionDir)tests\Rca.Network.Tests\bin\$(Configuration)\$(RcaTestTargetFramework)</_NetworkTestBinDir>
      <_NetworkTestDll>$(_NetworkTestBinDir)\Rca.Network.dll</_NetworkTestDll>
      <_NetworkTestPdb>$(_NetworkTestBinDir)\Rca.Network.pdb</_NetworkTestPdb>
      <_NetworkInstrumentedDll>$(AltCoverInputDir)\Rca.Network.dll</_NetworkInstrumentedDll>

      <!-- Rca.UI -->
      <_UiTestBinDir>$(SolutionDir)tests\Rca.UI.Tests\bin\$(Configuration)\$(RcaTestTargetFramework)</_UiTestBinDir>
      <_UiTestDll>$(_UiTestBinDir)\Rca.UI.dll</_UiTestDll>
      <_UiTestPdb>$(_UiTestBinDir)\Rca.UI.pdb</_UiTestPdb>
      <_UiInstrumentedDll>$(AltCoverInputDir)\Rca.UI.dll</_UiInstrumentedDll>
    </PropertyGroup>

    <!-- Emit detailed warnings for unexpected states in test bin directories -->
    <!-- PDB is required as a sanity check that the test project was built correctly -->
    <Warning Text="AltCover: PDB file '$(_ContractsTestPdb)' for 'Rca.Contracts' not found. Skipping instrumentation copy for this test directory."
             Condition="!Exists('$(_ContractsTestPdb)')" />
    <Warning Text="AltCover: PDB file '$(_CoreTestPdb)' for 'Rca.Core' not found. Skipping instrumentation copy for this test directory."
             Condition="!Exists('$(_CoreTestPdb)')" />
    <Warning Text="AltCover: PDB file '$(_LoaderTestPdb)' for 'Rca.Loader' not found. Skipping instrumentation copy for this test directory."
             Condition="!Exists('$(_LoaderTestPdb)')" />
    <Warning Text="AltCover: PDB file '$(_NetworkTestPdb)' for 'Rca.Network' not found. Skipping instrumentation copy for this test directory."
             Condition="!Exists('$(_NetworkTestPdb)')" />
    <Warning Text="AltCover: PDB file '$(_UiTestPdb)' for 'Rca.UI' not found. Skipping instrumentation copy for this test directory."
             Condition="!Exists('$(_UiTestPdb)')" />

    <!-- When PDB exists but DLL is missing, something is off with test output -->
    <Warning Text="AltCover: Test DLL '$(_ContractsTestDll)' for 'Rca.Contracts' not found although PDB exists. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_ContractsTestPdb)') and !Exists('$(_ContractsTestDll)')" />
    <Warning Text="AltCover: Test DLL '$(_CoreTestDll)' for 'Rca.Core' not found although PDB exists. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_CoreTestPdb)') and !Exists('$(_CoreTestDll)')" />
    <Warning Text="AltCover: Test DLL '$(_LoaderTestDll)' for 'Rca.Loader' not found although PDB exists. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_LoaderTestPdb)') and !Exists('$(_LoaderTestDll)')" />
    <Warning Text="AltCover: Test DLL '$(_NetworkTestDll)' for 'Rca.Network' not found although PDB exists. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_NetworkTestPdb)') and !Exists('$(_NetworkTestDll)')" />
    <Warning Text="AltCover: Test DLL '$(_UiTestDll)' for 'Rca.UI' not found although PDB exists. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_UiTestPdb)') and !Exists('$(_UiTestDll)')" />

    <!-- When both PDB and DLL exist but the instrumented DLL is missing in RuntimeDeployDir -->
    <Warning Text="AltCover: Instrumented DLL '$(_ContractsInstrumentedDll)' for 'Rca.Contracts' not found in AltCover input directory. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_ContractsTestPdb)') and Exists('$(_ContractsTestDll)') and !Exists('$(_ContractsInstrumentedDll)')" />
    <Warning Text="AltCover: Instrumented DLL '$(_CoreInstrumentedDll)' for 'Rca.Core' not found in AltCover input directory. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_CoreTestPdb)') and Exists('$(_CoreTestDll)') and !Exists('$(_CoreInstrumentedDll)')" />
    <Warning Text="AltCover: Instrumented DLL '$(_LoaderInstrumentedDll)' for 'Rca.Loader' not found in AltCover input directory. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_LoaderTestPdb)') and Exists('$(_LoaderTestDll)') and !Exists('$(_LoaderInstrumentedDll)')" />
    <Warning Text="AltCover: Instrumented DLL '$(_NetworkInstrumentedDll)' for 'Rca.Network' not found in AltCover input directory. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_NetworkTestPdb)') and Exists('$(_NetworkTestDll)') and !Exists('$(_NetworkInstrumentedDll)')" />
    <Warning Text="AltCover: Instrumented DLL '$(_UiInstrumentedDll)' for 'Rca.UI' not found in AltCover input directory. Skipping instrumentation copy for this test directory."
             Condition="Exists('$(_UiTestPdb)') and Exists('$(_UiTestDll)') and !Exists('$(_UiInstrumentedDll)')" />

    <!-- Copy instrumented DLLs from RuntimeDeployDir into test bin directories (overwriting originals when present) -->
    <Copy SourceFiles="$(_ContractsInstrumentedDll)"
          DestinationFiles="$(_ContractsTestDll)"
          Condition="Exists('$(_ContractsTestPdb)') and Exists('$(_ContractsTestDll)') and Exists('$(_ContractsInstrumentedDll)')" />
    <Copy SourceFiles="$(_CoreInstrumentedDll)"
          DestinationFiles="$(_CoreTestDll)"
          Condition="Exists('$(_CoreTestPdb)') and Exists('$(_CoreTestDll)') and Exists('$(_CoreInstrumentedDll)')" />
    <Copy SourceFiles="$(_LoaderInstrumentedDll)"
          DestinationFiles="$(_LoaderTestDll)"
          Condition="Exists('$(_LoaderTestPdb)') and Exists('$(_LoaderTestDll)') and Exists('$(_LoaderInstrumentedDll)')" />
    <Copy SourceFiles="$(_NetworkInstrumentedDll)"
          DestinationFiles="$(_NetworkTestDll)"
          Condition="Exists('$(_NetworkTestPdb)') and Exists('$(_NetworkTestDll)') and Exists('$(_NetworkInstrumentedDll)')" />
    <Copy SourceFiles="$(_UiInstrumentedDll)"
          DestinationFiles="$(_UiTestDll)"
          Condition="Exists('$(_UiTestPdb)') and Exists('$(_UiTestDll)') and Exists('$(_UiInstrumentedDll)')" />

    <!-- Copy AltCover recorder into the same test bin directories where we replaced assemblies -->
    <Copy SourceFiles="$(AltCoverInputDir)\AltCover.Recorder.g.dll"
          DestinationFiles="$(_ContractsTestBinDir)\AltCover.Recorder.g.dll"
          Condition="Exists('$(AltCoverInputDir)\AltCover.Recorder.g.dll') and Exists('$(_ContractsTestPdb)') and Exists('$(_ContractsTestDll)')" />
    <Copy SourceFiles="$(AltCoverInputDir)\AltCover.Recorder.g.dll"
          DestinationFiles="$(_CoreTestBinDir)\AltCover.Recorder.g.dll"
          Condition="Exists('$(AltCoverInputDir)\AltCover.Recorder.g.dll') and Exists('$(_CoreTestPdb)') and Exists('$(_CoreTestDll)')" />
    <Copy SourceFiles="$(AltCoverInputDir)\AltCover.Recorder.g.dll"
          DestinationFiles="$(_LoaderTestBinDir)\AltCover.Recorder.g.dll"
          Condition="Exists('$(AltCoverInputDir)\AltCover.Recorder.g.dll') and Exists('$(_LoaderTestPdb)') and Exists('$(_LoaderTestDll)')" />
    <Copy SourceFiles="$(AltCoverInputDir)\AltCover.Recorder.g.dll"
          DestinationFiles="$(_NetworkTestBinDir)\AltCover.Recorder.g.dll"
          Condition="Exists('$(AltCoverInputDir)\AltCover.Recorder.g.dll') and Exists('$(_NetworkTestPdb)') and Exists('$(_NetworkTestDll)')" />
    <Copy SourceFiles="$(AltCoverInputDir)\AltCover.Recorder.g.dll"
          DestinationFiles="$(_UiTestBinDir)\AltCover.Recorder.g.dll"
          Condition="Exists('$(AltCoverInputDir)\AltCover.Recorder.g.dll') and Exists('$(_UiTestPdb)') and Exists('$(_UiTestDll)')" />

  </Target>

  <!-- Collect coverage after tests complete. Should be invoked manually via MSBuild after tests have been executed -->
  <!-- Usage: dotnet msbuild rca-plugin.sln /t:CollectCoverage /p:AltCoverEnabled=true -->
  <!-- Or any project : dotnet msbuild src/Rca.Runtime/Rca.Runtime.csproj /t:CollectCoverage /p:AltCoverEnabled=true -->
  <!-- Condition ensures it only runs once and not during design-time builds -->
  <Target Name="CollectCoverage" Condition="'$(AltCoverEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <!-- Determine AltCoverRecorderDir from RuntimeDeployDir, or from timestamp file if not set -->
    <PropertyGroup>
      <AltCoverRecorderDir Condition="'$(RuntimeDeployDir)' != ''">$(RuntimeDeployDir)</AltCoverRecorderDir>
      <AltCoverRecorderDir Condition="'$(RuntimeDeployDir)' == '' and Exists('$(RcaTimestampFile)')">$(RcaRevitAddinsDir)\$([System.IO.File]::ReadAllText('$(RcaTimestampFile)').Trim())</AltCoverRecorderDir>
    </PropertyGroup>

    <!-- Validate that we have a valid recorder directory -->
    <Error Text="Cannot determine recorder directory for coverage collection. RuntimeDeployDir is not set and timestamp file is missing or empty." 
           Condition="'$(AltCoverRecorderDir)' == ''" />
    
    <!-- Warn if signal file is missing -->
    <Warning Text="AltCover signal file not found at $(AltCoverSignalFile). Coverage collection may be incomplete." 
             Condition="'$(AltCoverSignalFile)' != '' and !Exists('$(AltCoverSignalFile)')" />

    <!-- Remove signal file if it exists -->
    <Delete Files="$(AltCoverSignalFile)" Condition="'$(AltCoverSignalFile)' != '' and Exists('$(AltCoverSignalFile)')" />

    <!-- Run AltCover runner to collect coverage -->
    <Message Text="Collecting coverage from $(AltCoverRecorderDir)..." Importance="High" />    
    <Exec Command='altcover runner --collect --recorderDirectory="$(AltCoverRecorderDir)"'
          ContinueOnError="false" />
    
    <!-- Check if coverage file was created successfully -->
    <PropertyGroup>
      <CoverageFileCreated Condition="Exists('$(RcaCoverageOutputFile)')">true</CoverageFileCreated>
      <CoverageFileCreated Condition="!Exists('$(RcaCoverageOutputFile)')">false</CoverageFileCreated>
    </PropertyGroup>
    
    <Message Text="Coverage collected successfully to $(RcaCoverageOutputFile)" Importance="High" Condition="'$(CoverageFileCreated)' == 'true'" />
    
    <!-- Copy coverage file to storage location to prevent coverage data from being overwritten during builds -->
    <Copy SourceFiles="$(RcaCoverageOutputFile)" 
          DestinationFiles="$(RcaCoverageStorageFile)" 
          Condition="'$(CoverageFileCreated)' == 'true'" 
          SkipUnchangedFiles="true" />
    <Message Text="Coverage file copied to storage location: $(RcaCoverageStorageFile)" Importance="Normal" Condition="'$(CoverageFileCreated)' == 'true'" />
    
    <!-- Recreate signal file to enable continuous coverage collection -->
    <WriteLinesToFile File="$(AltCoverSignalFile)" Lines="" Overwrite="true" Condition="'$(CoverageFileCreated)' == 'true'" />
    <Message Text="Signal file recreated at $(AltCoverSignalFile) for continuous coverage collection" Importance="Normal" Condition="'$(CoverageFileCreated)' == 'true'" />
    
    <!-- Generate HTML report using reportgenerator -->
    <MakeDir Directories="$(CoverageHtmlDir)" Condition="'$(CoverageFileCreated)' == 'true'" />
    <Message Text="Generating HTML coverage report in $(CoverageHtmlDir)..." Importance="High" Condition="'$(CoverageFileCreated)' == 'true'" />
    <Exec Command='reportgenerator -reports:"$(RcaCoverageOutputFile)" -targetdir:"$(CoverageHtmlDir)" -reporttypes:Html'
          ContinueOnError="false"
          Condition="'$(CoverageFileCreated)' == 'true'" />
    <Message Text="HTML coverage report generated in $(CoverageHtmlDir)" Importance="High" Condition="'$(CoverageFileCreated)' == 'true'" />
  </Target>

  <!-- Generate consolidated metrics dashboard after all metrics are collected -->
  <!-- When GenerateHtmlFromJson=true, generates HTML from existing JSON without collecting metrics -->
  <!-- DependsOnTargets ensures GenerateSolutionMetrics completes first in normal mode -->
  <!-- If GenerateSolutionMetrics doesn't run (RoslynMetricsEnabled=false), dependency is skipped gracefully -->
  <Target Name="GenerateMetricsDashboard"
          AfterTargets="Build"
          DependsOnTargets="GenerateSolutionMetrics"
          Condition="'$(GenerateMetricsDashboard)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Rca.MetricsReporter.Tests'">

    <!-- When GenerateHtmlFromJson=true, skip metric collection and generate HTML from existing JSON -->
    <PropertyGroup Condition="'$(GenerateHtmlFromJson)' == 'true'">
      <InputJsonFile Condition="'$(InputJsonFile)' == ''">$(MetricsReportJson)</InputJsonFile>
      <OutputHtmlFile Condition="'$(OutputHtmlFile)' == ''">$(MetricsReportHtml)</OutputHtmlFile>
      <MetricsReporterCommand>"$(MetricsReporterExe)" --input-json "$(InputJsonFile)" --output-html "$(OutputHtmlFile)"</MetricsReporterCommand>
    </PropertyGroup>

    <!-- Error if input JSON file not found when using GenerateHtmlFromJson mode -->
    <Error Text="Input JSON file not found at '$(InputJsonFile)'. Cannot generate HTML report." 
           Condition="'$(GenerateHtmlFromJson)' == 'true' and !Exists('$(InputJsonFile)')" />

    <!-- Normal mode: collect metrics and generate dashboard -->

    <PropertyGroup Condition="'$(GenerateHtmlFromJson)' != 'true'">
      <!-- Verify that solution metrics file exists before generating dashboard -->
      <_RoslynMetricsMissing Condition="'$(RoslynMetricsEnabled)' == 'true' and !Exists('$(RoslynSolutionMetricsOutputFile)')">true</_RoslynMetricsMissing>
    </PropertyGroup>

    <Error Text="Solution metrics file not found at '$(RoslynSolutionMetricsOutputFile)'. Metrics calculation may have failed." 
           Condition="'$(GenerateHtmlFromJson)' != 'true' and '$(_RoslynMetricsMissing)' == 'true'" />

    <ItemGroup Condition="'$(GenerateHtmlFromJson)' != 'true'">
      <RoslynMetricsFiles Include="$(RoslynSolutionMetricsOutputFile)" Condition="Exists('$(RoslynSolutionMetricsOutputFile)')" />
      <SarifMetricsFiles Include="$(SarifOutputDir)\*.sarif" />
    </ItemGroup>

    <PropertyGroup Condition="'$(GenerateHtmlFromJson)' != 'true'">
      <MetricsReporterAltCoverArg Condition="Exists('$(RcaCoverageStorageFile)')"> --altcover "$(RcaCoverageStorageFile)"</MetricsReporterAltCoverArg>
      <MetricsReporterRoslynArgs>@(RoslynMetricsFiles->' --roslyn "%(FullPath)"', ' ')</MetricsReporterRoslynArgs>
      <MetricsReporterSarifArgs>@(SarifMetricsFiles->' --sarif "%(FullPath)"', ' ')</MetricsReporterSarifArgs>
      <MetricsReporterBaselineArg Condition="'$(ReplaceMetricsBaseline)' == 'true' or Exists('$(MetricsBaselineJson)')"> --baseline "$(MetricsBaselineJson)"</MetricsReporterBaselineArg>
      <MetricsReporterBaselineRefArg Condition="'$(MetricsBaselineReference)' != ''"> --baseline-ref "$(MetricsBaselineReference)"</MetricsReporterBaselineRefArg>
      <MetricsReporterThresholdArg Condition="Exists('$(MetricsThresholdsPath)')"> --thresholds-file "$(MetricsThresholdsPath)"</MetricsReporterThresholdArg>
      <MetricsReporterExcludedMethodsArg Condition="'$(ExcludedMethodNames)' != ''"> --excluded-methods "$(ExcludedMethodNames)"</MetricsReporterExcludedMethodsArg>
      <MetricsReporterExcludedAssembliesArg Condition="'$(ExcludedAssemblyNames)' != ''"> --excluded-assemblies "$(ExcludedAssemblyNames)"</MetricsReporterExcludedAssembliesArg>
      <MetricsReporterReplaceBaselineArg Condition="'$(ReplaceMetricsBaseline)' == 'true'"> --replace-baseline</MetricsReporterReplaceBaselineArg>
      <MetricsReporterBaselineStoragePathArg Condition="'$(ReplaceMetricsBaseline)' == 'true' and '$(MetricsReportStoragePath)' != ''"> --baseline-storage-path "$(MetricsReportStoragePath)"</MetricsReporterBaselineStoragePathArg>
      <MetricsReporterCoverageHtmlDirArg Condition="Exists('$(CoverageHtmlDir)')"> --coverage-html-dir "$(CoverageHtmlDir)"</MetricsReporterCoverageHtmlDirArg>
      <MetricsReporterCommand>"$(MetricsReporterExe)" --solution-name "$(MetricsSolutionName)" --metrics-dir "$(RcaMetricsDir)"$(MetricsReporterAltCoverArg)$(MetricsReporterRoslynArgs)$(MetricsReporterSarifArgs)$(MetricsReporterBaselineArg)$(MetricsReporterBaselineRefArg) --output-json "$(MetricsReportJson)" --output-html "$(MetricsReportHtml)"$(MetricsReporterThresholdArg)$(MetricsReporterExcludedMethodsArg)$(MetricsReporterExcludedAssembliesArg)$(MetricsReporterReplaceBaselineArg)$(MetricsReporterBaselineStoragePathArg)$(MetricsReporterCoverageHtmlDirArg)</MetricsReporterCommand>
    </PropertyGroup>

    <Message Text="Generating HTML report from existing JSON: $(InputJsonFile)" Importance="High" Condition="'$(GenerateHtmlFromJson)' == 'true' and Exists('$(MetricsReporterExe)')" />
    <Message Text="Generating metrics dashboard (Rca.MetricsReporter.Tests)." Importance="High" Condition="'$(GenerateHtmlFromJson)' != 'true' and Exists('$(MetricsReporterExe)')" />
    <MakeDir Directories="$(MetricsReportDir)" />
    <Exec Command="$(MetricsReporterCommand)"
          WorkingDirectory="$(SolutionDir)"
          IgnoreExitCode="false"
          Condition="Exists('$(MetricsReporterExe)')" />
  </Target>
</Project>


