<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Hash generation for hot-reloading system -->

  <!-- Ensure SourceHashGenerator -->
  <Target Name="BuildSourceHashGenerator" BeforeTargets="GenerateHash" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' != 'SourceHashGenerator' and '$(MSBuildProjectName)' != 'Rca.BuildMetadata.Generator' and ('$(IsLoaderGroupProject)' == 'true' or '$(IsRuntimeGroupProject)' == 'true')">
    <PropertyGroup>
      <SourceHashProjectModTime>$([System.IO.File]::GetLastWriteTime('$(SourceHashProject)').Ticks)</SourceHashProjectModTime>
      <SourceHashExeModTime Condition="Exists('$(SourceHashExe)')">$([System.IO.File]::GetLastWriteTime('$(SourceHashExe)').Ticks)</SourceHashExeModTime>
      <SourceHashExeModTime Condition="!Exists('$(SourceHashExe)')">0</SourceHashExeModTime>
    </PropertyGroup>
    <!-- Build SourceHashGenerator only when project changed or exe missing -->
    <MSBuild Projects="$(SourceHashProject)" Targets="Build" Properties="Configuration=$(Configuration)" Condition="'$(SourceHashProjectModTime)' &gt; '$(SourceHashExeModTime)' or !Exists('$(SourceHashExe)')" />
  </Target>

  <!-- Ensure runtime deploy folder exists before generating hashes -->
  <Target Name="EnsureRuntimeDeployFolder" Condition="'$(DesignTimeBuild)' != 'true' and ('$(IsLoaderGroupProject)' == 'true' or '$(IsRuntimeGroupProject)' == 'true')" BeforeTargets="GenerateHash">
    <PropertyGroup>
      <_RuntimeDeployDir>$(RcaRevitAddinsDir)\$(RcaHotReloadTimestamp)</_RuntimeDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(_RuntimeDeployDir)" />
    <Message Text="EnsureRuntimeDeployFolder: created $(_RuntimeDeployDir)" Importance="Low" />
  </Target>

  <!-- Compute hashes. Generator writes marker files and outputs into deploy/<timestamp> only -->
  <Target Name="GenerateHash" BeforeTargets="CoreCompile" DependsOnTargets="EnsureRcaTimestamp;EnsureRuntimeDeployFolder;BuildSourceHashGenerator" Condition="'$(DesignTimeBuild)' != 'true' and ( '$(IsLoaderGroupProject)' == 'true' or '$(IsRuntimeGroupProject)' == 'true' )">
    <Message Text="GenerateHash: compute loader/runtime hashes (deploy-only)" Importance="Low" />

    <!-- Call generator for Loader group: generator will create marker files SourceHash-Loader-<hash>.txt in deploy timestamp folder -->
    <Exec Command='&quot;$(SourceHashExe)&quot; --roots &quot;$(RcaLoaderRoots)&quot; --group Loader --timestamp &quot;$(RcaHotReloadTimestamp)&quot; --deployDir &quot;$(RcaRevitAddinsDir)&quot; --wait-ms 600000 --short-length $(RcaSourceHashLength)' />

    <!-- Call generator for Runtime group: generator will create marker files SourceHash-Runtime-<hash>.txt in deploy timestamp folder -->
    <Exec Command='&quot;$(SourceHashExe)&quot; --roots &quot;$(RcaRuntimeRoots)&quot; --group Runtime --timestamp &quot;$(RcaHotReloadTimestamp)&quot; --deployDir &quot;$(RcaRevitAddinsDir)&quot; --wait-ms 600000 --short-length $(RcaSourceHashLength)' />

    <!-- Generator creates marker files in $(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp); no duplicate out files are produced anymore -->
  </Target>
</Project>

