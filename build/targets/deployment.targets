<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Deployment targets for Loader and Runtime groups -->

  <!-- Deploy groups (real builds only) -->
  <Target Name="DeployLoaderGroup" AfterTargets="Build" DependsOnTargets="EnsureRcaTimestamp" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Rca.Loader'">
    <MakeDir Directories="$(RuntimeDeployDir)" />
    <ItemGroup>
      <LoaderDeployFiles Include="$(TargetDir)Rca.Loader.dll" />
      <LoaderDeployFiles Include="$(TargetDir)Rca.Loader.Contracts.dll" />
      <LoaderDeployFiles Include="$(TargetDir)Rca.Logging.Contracts.dll" />
      <!-- Ensure deps.json is deployed next to Loader for Default ALC probing -->
      <LoaderDeployFiles Include="$(TargetDir)Rca.Loader.deps.json" Condition="Exists('$(TargetDir)Rca.Loader.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(LoaderDeployFiles)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />

    <!-- Copy PDBs next to the DLLs -->
    <ItemGroup>
      <LoaderDeployPdbs Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(LoaderDeployPdbs)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" Condition="@(LoaderDeployPdbs)!='' and '$(AltCoverEnabled)' == 'true'" />

    <!-- Marker file is created by Rca.SourceHashGenerator in deploy folder -->

    <Message Text="Loader group deployed to $(RuntimeDeployDir)" Importance="High" />
  </Target>

  <Target Name="DeployRuntimeGroup" AfterTargets="Build" DependsOnTargets="EnsureRcaTimestamp" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Rca.Runtime'">
    <MakeDir Directories="$(RuntimeDeployDir)" />
    <ItemGroup>
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Runtime.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Core.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Network.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.UI.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Contracts.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Python.Runtime.dll" Condition="Exists('$(TargetDir)Python.Runtime.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDeployFiles)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />

    <!-- Copy PDBs next to the DLLs -->
    <ItemGroup>
      <RuntimeDeployPdbs Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDeployPdbs)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" Condition="@(RuntimeDeployPdbs)!='' and '$(AltCoverEnabled)' == 'true'" />

    <!-- Marker file is created by Rca.SourceHashGenerator in deploy folder -->

    <Message Text="Runtime group deployed to $(RuntimeDeployDir)" Importance="High" />
  </Target>
</Project>

