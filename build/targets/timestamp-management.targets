<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Timestamp management for hot-reloading system -->

  <!-- Ensure a single shared timestamp per real build with sticky TTL and force override -->
  <!-- Must run before CoreCompile so Source Generator can access RcaHotReloadTimestamp -->
  <Target Name="EnsureRcaTimestamp" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' != 'Rca.SourceHashGenerator'" BeforeTargets="PrepareForBuild">
    <!-- Create deploy root where timestamp and marker files will be stored (guarded if props are missing) -->
    <MakeDir Condition="'$(RcaRevitAddinsDir)' != ''" Directories="$(RcaRevitAddinsDir)" />
    <Exec Condition="'$(RcaTimestampFile)' != ''" Command='powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SolutionDir)build\Scripts\EnsureRcaStamp.ps1&quot; -TargetPath &quot;$(RcaTimestampFile)&quot; -TtlSec &quot;$(RcaStickyStampSeconds)&quot; -ForceStr &quot;$(RcaForceNewStamp)&quot; -TimestampPattern &quot;$(RcaTimestampPattern)&quot;' />

    <ReadLinesFromFile Condition="'$(RcaTimestampFile)' != ''" File="$(RcaTimestampFile)">
      <Output TaskParameter="Lines" ItemName="_StampLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <RcaHotReloadTimestamp>@(_StampLines)</RcaHotReloadTimestamp>
      <!-- Compute RuntimeDeployDir immediately after timestamp is available -->
      <!-- Single source of truth for deploy destination: eliminates duplication across deployment and hash-generation targets -->
      <!-- Format: %APPDATA%\Autodesk\Revit\Addins\$(RcaRevitVersion)\<timestamp> (e.g., 20251018_112825) -->
      <RuntimeDeployDir>$(RcaRevitAddinsDir)\$(RcaHotReloadTimestamp)</RuntimeDeployDir>
    </PropertyGroup>
    <Message Text="EnsureRcaTimestamp: $(RcaHotReloadTimestamp) (TTL=$(RcaStickyStampSeconds)s, Force=$(RcaForceNewStamp))" Importance="Low" />
    <Message Text="EnsureRcaTimestamp: RuntimeDeployDir = $(RuntimeDeployDir)" Importance="Low" />
  </Target>

  <!-- Generate Rca.addin file for Loader project -->
  <!-- This target runs after Build and EnsureRcaTimestamp to ensure timestamp is always correct -->
  <!-- It always reads timestamp from file to guarantee correctness in all build contexts -->
  <Target Name="GenerateRcaAddinFile" 
          AfterTargets="Build" 
          DependsOnTargets="EnsureRcaTimestamp"
          Condition="'$(GenerateRcaAddinFile)' == 'true' and '$(MSBuildProjectName)' == 'Rca.Loader' and '$(DesignTimeBuild)' != 'true'">
    
    <!-- Always read timestamp from file to ensure correctness even if RcaHotReloadTimestamp property is not set -->
    <!-- This ensures timestamp is correct regardless of build context (direct build, rebuild triggered by external tools, etc.) -->
    <ReadLinesFromFile Condition="'$(RcaTimestampFile)' != '' and Exists('$(RcaTimestampFile)')" File="$(RcaTimestampFile)">
      <Output TaskParameter="Lines" ItemName="_TimestampFileLines" />
    </ReadLinesFromFile>
    
    <PropertyGroup>
      <!-- Resolve timestamp: prefer property, then file content, with fallback to reading file directly -->
      <_ResolvedTimestamp Condition="'$(RcaHotReloadTimestamp)' != ''">$(RcaHotReloadTimestamp)</_ResolvedTimestamp>
      <_ResolvedTimestamp Condition="'$(RcaHotReloadTimestamp)' == '' and '@(_TimestampFileLines)' != ''">@(_TimestampFileLines)</_ResolvedTimestamp>
      <_ResolvedTimestamp Condition="'$(_ResolvedTimestamp)' == '' and '$(RcaTimestampFile)' != '' and Exists('$(RcaTimestampFile)')">$([System.IO.File]::ReadAllText('$(RcaTimestampFile)').Trim())</_ResolvedTimestamp>
      
      <!-- Ensure assembly relative path uses the resolved timestamp if not overridden -->
      <RcaAddinAssemblyRelativePath Condition="'$(RcaAddinAssemblyRelativePath)' == '' and '$(_ResolvedTimestamp)' != ''">$(_ResolvedTimestamp)\Rca.Loader.dll</RcaAddinAssemblyRelativePath>
      
      <AddinDestFile>$(RcaRevitAddinsDir)\Rca.addin</AddinDestFile>
    </PropertyGroup>

    <!-- Validate that we have a valid timestamp -->
    <Error Condition="'$(_ResolvedTimestamp)' == ''" 
           Text="Cannot generate Rca.addin: timestamp could not be resolved. Timestamp file: $(RcaTimestampFile), RcaHotReloadTimestamp: $(RcaHotReloadTimestamp)" />

    <ReadLinesFromFile File="$(RcaAddinTemplatePath)">
      <Output TaskParameter="Lines" ItemName="TemplateLines" />
    </ReadLinesFromFile>

    <ItemGroup>
      <TemplateLinesProcessed Include="@(TemplateLines)">
        <Replaced>$([System.Text.RegularExpressions.Regex]::Replace('%(TemplateLines.Identity)','RcaAddinAssemblyRelativePath','$(RcaAddinAssemblyRelativePath)'))</Replaced>
      </TemplateLinesProcessed>
    </ItemGroup>

    <WriteLinesToFile File="$(AddinDestFile)" Lines="@(TemplateLinesProcessed->'%(Replaced)')" Overwrite="true" />
    <Message Text="Generated Rca.addin with Assembly=$(RcaAddinAssemblyRelativePath) at $(AddinDestFile)" Importance="High" />
  </Target>
</Project>

