<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Hot-reloading system configuration (timestamps, TTL, flags, deploy paths) -->
  <PropertyGroup>
    <!-- Timestamp file location: stores the current build timestamp under mutex protection -->
    <!-- Used for coordination across parallel MSBuild processes and test invocation phases -->
    <RcaTimestampFile Condition="'$(RcaTimestampFile)' == ''">$(RcaRevitAddinsDir)\Timestamp.txt</RcaTimestampFile>

    <!-- Sticky timestamp configuration: reuse timestamp across separate MSBuild invocations within TTL window -->
    <!-- Rationale: test runners and IDEs spawn multiple builds; TTL prevents accidental folder drift -->
    <RcaStickyStampSeconds Condition="'$(RcaStickyStampSeconds)' == ''">90</RcaStickyStampSeconds>
    <!-- Force override: set to true/1 to force a fresh timestamp, ignoring TTL stickiness -->
    <RcaForceNewStamp Condition="'$(RcaForceNewStamp)' == ''">false</RcaForceNewStamp>
    <!-- Named pipe for loader <-> UI commands -->
    <RcaCommandPipeName Condition="'$(RcaCommandPipeName)' == ''">RCA_COMMAND_PIPE</RcaCommandPipeName>
    <!-- Named pipe for UI logging transport -->
    <RcaLogPipeName Condition="'$(RcaLogPipeName)' == ''">RCA_LOG_PIPE</RcaLogPipeName>
    <!-- Centralized length of short source hash (single source of truth) -->
    <RcaSourceHashLength Condition="'$(RcaSourceHashLength)' == ''">3</RcaSourceHashLength>
    <!-- Centralized timestamp folder pattern for build output directories -->
    <RcaTimestampPattern Condition="'$(RcaTimestampPattern)' == ''">yyyyMMdd_HHmmss</RcaTimestampPattern>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RcaTimestampFile" />
    <CompilerVisibleProperty Include="RcaStickyStampSeconds" />
    <CompilerVisibleProperty Include="RcaForceNewStamp" />
    <CompilerVisibleProperty Include="RcaCommandPipeName" />
    <CompilerVisibleProperty Include="RcaLogPipeName" />
    <CompilerVisibleProperty Include="RcaSourceHashLength" />
    <CompilerVisibleProperty Include="RcaTimestampPattern" />
    <CompilerVisibleProperty Include="RcaHotReloadTimestamp" />
  </ItemGroup>
</Project>


