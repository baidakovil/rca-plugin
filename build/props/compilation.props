<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Compilation-related flags -->
  <PropertyGroup>
    <!-- Ensure analyzers (source generators) run during build -->
    <RunAnalyzersDuringBuild Condition="'$(RunAnalyzersDuringBuild)' == ''">true</RunAnalyzersDuringBuild>
    <RunAnalyzers Condition="'$(RunAnalyzers)' == ''">true</RunAnalyzers>
    <EnforceCodeStyleInBuild Condition="'$(EnforceCodeStyleInBuild)' == ''">true</EnforceCodeStyleInBuild>
    <!-- Do not surface generator outputs as physical files under source tree to avoid duplicates -->
    <EmitCompilerGeneratedFiles Condition="'$(EmitCompilerGeneratedFiles)' == ''">false</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <!-- Optimize ProjectReference evaluation: skip GetTargetFrameworks for all ProjectReference items -->
  <!-- WHY: All projects in solution use the same TargetFramework (net8.0-windows), so framework compatibility -->
  <!-- NOTE: ItemDefinitionGroup applies to all ProjectReference items regardless of where they are declared -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <SkipGetTargetFrameworkProperties Condition="'%(ProjectReference.SkipGetTargetFrameworkProperties)' == ''">true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RunAnalyzersDuringBuild" />
    <CompilerVisibleProperty Include="EmitCompilerGeneratedFiles" />
    <!-- Make project name visible to Source Generators for conditional emission -->
    <CompilerVisibleProperty Include="MSBuildProjectName" />
  </ItemGroup>

  <!-- Attach Build Metadata Source Generator to all projects (as Analyzer) -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Rca.BuildMetadata.Generator' and '$(MSBuildProjectName)' != 'SourceHashGenerator'">
    <ProjectReference Include="$(SolutionDir)src\Tools\Rca.BuildMetadata.Generator\Rca.BuildMetadata.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <!-- Add Microsoft.CodeAnalysis.Metrics package to all projects that need it -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Rca.BuildMetadata.Generator' and '$(MSBuildProjectName)' != 'SourceHashGenerator'">
    <PackageReference Include="Microsoft.CodeAnalysis.Metrics" Version="4.14.0" />
  </ItemGroup>

</Project>

