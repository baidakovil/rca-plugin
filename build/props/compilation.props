<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Compilation-related flags -->
  <PropertyGroup>
    <!-- Ensure analyzers (source generators) run during build -->
    <RunAnalyzersDuringBuild Condition="'$(RunAnalyzersDuringBuild)' == ''">true</RunAnalyzersDuringBuild>
    <!-- Do not surface generator outputs as physical files under source tree to avoid duplicates -->
    <EmitCompilerGeneratedFiles Condition="'$(EmitCompilerGeneratedFiles)' == ''">false</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RunAnalyzersDuringBuild" />
    <CompilerVisibleProperty Include="EmitCompilerGeneratedFiles" />
    <!-- Make project name visible to Source Generators for conditional emission -->
    <CompilerVisibleProperty Include="MSBuildProjectName" />
  </ItemGroup>

  <!-- Attach Build Metadata Source Generator to all projects (as Analyzer) -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Rca.BuildMetadata.Generator' and '$(MSBuildProjectName)' != 'SourceHashGenerator'">
    <ProjectReference Include="$(SolutionDir)src\Tools\Rca.BuildMetadata.Generator\Rca.BuildMetadata.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

