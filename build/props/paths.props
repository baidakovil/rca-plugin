<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Path-related MSBuild properties centralized here -->
  <PropertyGroup>
    <!-- Ensure Configuration has a default value before it's used in path calculations -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <!-- Directory where Revit Addins and timestamp subfolders are located -->
    <RcaRevitAddinsDir Condition="'$(RcaRevitAddinsDir)' == ''">$(APPDATA)\Autodesk\Revit\Addins\$(RcaRevitVersion)</RcaRevitAddinsDir>
    <!-- Directory where integration test builds are deployed -->
    <RcaTestDeployRoot Condition="'$(RcaTestDeployRoot)' == ''">$(LOCALAPPDATA)\RCA\Test</RcaTestDeployRoot>
    <!-- Directory where RCA logs are written -->
    <RcaLogRoot Condition="'$(RcaLogRoot)' == ''">$(LOCALAPPDATA)\RCA\Logs</RcaLogRoot>

    <!-- Directory for code metrics output files -->
    <RcaMetricsDir Condition="'$(RcaMetricsDir)' == ''">$(SolutionDir)build\Metrics</RcaMetricsDir>

    <!-- Aggregated metrics report artifacts -->
    <MetricsReportDir Condition="'$(MetricsReportDir)' == ''">$(RcaMetricsDir)\Report</MetricsReportDir>
    <MetricsReportJson Condition="'$(MetricsReportJson)' == ''">$(MetricsReportDir)\metrics-report.json</MetricsReportJson>
    <!-- Baseline file is stored alongside other static metrics rules to keep it under source-controlled configuration. -->
    <CodeMetricsRulesDir Condition="'$(CodeMetricsRulesDir)' == ''">$(SolutionDir)build\MetricsRules</CodeMetricsRulesDir>
    <MetricsBaselineJson Condition="'$(MetricsBaselineJson)' == ''">$(CodeMetricsRulesDir)\metrics-baseline.g.json</MetricsBaselineJson>
    <MetricsThresholdsPath Condition="'$(MetricsThresholdsPath)' == ''">$(CodeMetricsRulesDir)\MetricsReporterThresholds.json</MetricsThresholdsPath>
    <!-- Path to JSON file with suppressed symbol metadata produced by Roslyn analysis. -->
    <RcaSuppressedSymbolsJson Condition="'$(RcaSuppressedSymbolsJson)' == ''">$(CodeMetricsRulesDir)\RcaSuppressedSymbols.json</RcaSuppressedSymbolsJson>
    <CodeMetricsConfigFile Condition="'$(CodeMetricsConfigFile)' == ''">$(CodeMetricsRulesDir)\CodeMetricsConfig.txt</CodeMetricsConfigFile>
    <MetricsReportHtml Condition="'$(MetricsReportHtml)' == ''">$(MetricsReportDir)\metrics-report.html</MetricsReportHtml>
    <MetricsSolutionName Condition="'$(MetricsSolutionName)' == ''">rca-plugin</MetricsSolutionName>
    <MetricsReporterProject Condition="'$(MetricsReporterProject)' == ''">$(SolutionDir)src\Tools\Rca.MetricsReporter\Rca.MetricsReporter.csproj</MetricsReporterProject>
    <MetricsReporterExe Condition="'$(MetricsReporterExe)' == ''">$(SolutionDir)src\Tools\Rca.MetricsReporter\bin\$(Configuration)\net8.0\Rca.MetricsReporter.exe</MetricsReporterExe>
    <MetricsBaselineReference Condition="'$(MetricsBaselineReference)' == ''"></MetricsBaselineReference>
    <!-- Directory where old baseline files are archived with timestamps -->
    <MetricsReportStoragePath Condition="'$(MetricsReportStoragePath)' == ''">$(LOCALAPPDATA)\RCA\Metrics</MetricsReportStoragePath>



    <!-- Roslyn Code Metrics -->
    <!-- Directory for Roslyn output files -->
    <RoslynOutputDir Condition="'$(RoslynOutputDir)' == ''">$(RcaMetricsDir)\Roslyn</RoslynOutputDir>
    <!-- Output file for Roslyn Analyzer (MetricsOutputFile is an system property) -->
    <MetricsOutputFile Condition="'$(MetricsOutputFile)' == ''">$(RoslynOutputDir)\$(MSBuildProjectName).xml</MetricsOutputFile>

    <!-- AltCover Code Metrics -->
    <!-- Name for AltCover file-->
    <CoverageOutputFileName Condition="'$(CoverageOutputFileName)' == ''">coverage.xml</CoverageOutputFileName>
    <!-- Directory for AltCover output files -->
    <AltCoverOutputDir Condition="'$(AltCoverOutputDir)' == ''">$(RcaMetricsDir)\AltCover</AltCoverOutputDir>
    <!-- Output file for final coverage report -->
    <RcaCoverageOutputFile Condition="'$(RcaCoverageOutputFile)' == ''">$(AltCoverOutputDir)\$(CoverageOutputFileName)</RcaCoverageOutputFile>
    <!-- Path to AltCover signal file-->
    <AltCoverSignalFile Condition="'$(AltCoverSignalFile)' == ''">$(AltCoverOutputDir)\$(CoverageOutputFileName).acv</AltCoverSignalFile>
    <!-- Path to stored coverage file that can be consumed by external tools (e.g. metrics reporter) -->
    <RcaCoverageStorageFile Condition="'$(RcaCoverageStorageFile)' == ''">$(AltCoverOutputDir)\coverage_storage.xml</RcaCoverageStorageFile>
    <!-- Directory for HTML coverage reports generated by reportgenerator -->
    <CoverageHtmlDir Condition="'$(CoverageHtmlDir)' == ''">$(AltCoverOutputDir)\html</CoverageHtmlDir>

    <!-- Path to Revit API libs (RevitAPI.dll, RevitAPIUI.dll) -->
    <RcaRevitLibsPath Condition="'$(RcaRevitLibsPath)' == ''">$(SolutionDir)libs\Revit\$(RcaRevitVersion)</RcaRevitLibsPath>
    <!-- Path to addin template used by GenerateRcaAddinFile target (can be overridden per environment) -->
    <RcaAddinTemplatePath Condition="'$(RcaAddinTemplatePath)' == ''">$(SolutionDir)build\Resources\Rca.addin.template</RcaAddinTemplatePath>

    <!-- Sarif Code Metrics -->
    <!-- Directory for Sarif output files -->
    <SarifOutputDir Condition="'$(SarifOutputDir)' == ''">$(RcaMetricsDir)\Sarif</SarifOutputDir>

    <!-- Generator project and executable paths -->
    <SourceHashProject>$(SolutionDir)src\Tools\Rca.SourceHashGenerator\Rca.SourceHashGenerator.csproj</SourceHashProject>
    <SourceHashExe>$(SolutionDir)src\Tools\Rca.SourceHashGenerator\bin\$(Configuration)\net8.0\Rca.SourceHashGenerator.exe</SourceHashExe>

    <!-- Source code roots for Loader and Runtime groups: directories scanned by Rca.SourceHashGenerator -->
    <!-- These paths are used for hash computation; project names are defined in project-groups.props -->
    <RcaLoaderRoots>$(SolutionDir)src\Rca.Loader;$(SolutionDir)src\Rca.Loader.Contracts;$(SolutionDir)src\Rca.Logging.Contracts</RcaLoaderRoots>
    <RcaRuntimeRoots>$(SolutionDir)src\Rca.Core;$(SolutionDir)src\Rca.Runtime;$(SolutionDir)src\Rca.Network;$(SolutionDir)src\Rca.UI;$(SolutionDir)src\Rca.Contracts</RcaRuntimeRoots>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RcaRevitAddinsDir" />
    <CompilerVisibleProperty Include="RcaTestDeployRoot" />
    <CompilerVisibleProperty Include="RcaLogRoot" />
    <CompilerVisibleProperty Include="RcaMetricsDir" />
    <CompilerVisibleProperty Include="MetricsReportDir" />
    <CompilerVisibleProperty Include="MetricsReportJson" />
    <CompilerVisibleProperty Include="MetricsBaselineJson" />
    <CompilerVisibleProperty Include="MetricsThresholdsPath" />
    <CompilerVisibleProperty Include="MetricsReportHtml" />
    <CompilerVisibleProperty Include="MetricsSolutionName" />
    <CompilerVisibleProperty Include="MetricsReporterProject" />
    <CompilerVisibleProperty Include="MetricsReporterExe" />
    <CompilerVisibleProperty Include="MetricsBaselineReference" />
    <CompilerVisibleProperty Include="MetricsReportStoragePath" />
    <!-- Coverage/AltCover paths visible to code that consumes coverage data -->
    <CompilerVisibleProperty Include="RcaCoverageOutputFile" />
    <CompilerVisibleProperty Include="RcaCoverageStorageFile" />
    <CompilerVisibleProperty Include="CoverageHtmlDir" />
    <CompilerVisibleProperty Include="RcaRevitLibsPath" />
    <CompilerVisibleProperty Include="RcaAddinTemplatePath" />
    <CompilerVisibleProperty Include="RcaAddinAssemblyRelativePath" />
    <CompilerVisibleProperty Include="SourceHashProject" />
    <CompilerVisibleProperty Include="SourceHashExe" />
    <CompilerVisibleProperty Include="RcaLoaderRoots" />
    <CompilerVisibleProperty Include="RcaRuntimeRoots" />
    <CompilerVisibleProperty Include="RcaSuppressedSymbolsJson" />
  </ItemGroup>
</Project>
