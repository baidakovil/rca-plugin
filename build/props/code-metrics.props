<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Code metrics configuration for AltCover integration -->
  <PropertyGroup>
    <!-- Enable/disable code metrics collection -->
    <!-- Set to true to enable Roslyn metrics collection -->
    <RoslynMetricsEnabled Condition="'$(RoslynMetricsEnabled)' == ''">false</RoslynMetricsEnabled>
    <!-- Set to true to enable Sarif metrics collection -->
    <SarifMetricsEnabled Condition="'$(SarifMetricsEnabled)' == ''">true</SarifMetricsEnabled>
    <!-- Set to true to enable AltCover metrics collection -->
    <AltCoverEnabled Condition="'$(AltCoverEnabled)' == ''">true</AltCoverEnabled>
    <!-- Set to true to show verbose messages during coverage collection (altcover and reportgenerator output) -->
    <CoverageVerbose Condition="'$(CoverageVerbose)' == ''">false</CoverageVerbose>
    <!-- Assembly filter for AltCover instrumentation (which assemblies to instrument) -->
    <RcaCoverageAssemblyFilter Condition="'$(RcaCoverageAssemblyFilter)' == ''">Rca.*.dll</RcaCoverageAssemblyFilter>
    <!-- Method filter for AltCover instrumentation (which methods to exclude from coverage, e.g. constructors) -->
    <AltCoverMethodFilter Condition="'$(AltCoverMethodFilter)' == ''">.cctor|.ctor</AltCoverMethodFilter>
    <!-- Target framework of test projects whose binaries participate in AltCover-based metrics -->
    <RcaTestTargetFramework Condition="'$(RcaTestTargetFramework)' == ''">net8.0-windows</RcaTestTargetFramework>

    <!-- Directory that contains Metrics.exe and its dependencies. -->
    <RoslynMetricsToolDir Condition="'$(RoslynMetricsToolDir)' == ''">$(SolutionDir)build\Resources\Metrics\win-arm64</RoslynMetricsToolDir>
    <!-- Full path to Metrics.exe. -->
    <RoslynMetricsToolExe Condition="'$(RoslynMetricsToolExe)' == ''">$(RoslynMetricsToolDir)\Metrics.exe</RoslynMetricsToolExe>
    <!-- Solution file path and output file for metrics calculation -->
    <RoslynMetricsSolutionPath Condition="'$(RoslynMetricsSolutionPath)' == ''">$(SolutionDir)rca-plugin.sln</RoslynMetricsSolutionPath>

    <!-- Anchor project that triggers metrics collection/generation targets -->
    <MetricsTargetsAnchorProject Condition="'$(MetricsTargetsAnchorProject)' == ''">Rca.Core.Tests</MetricsTargetsAnchorProject>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="RoslynMetricsEnabled" />
    <CompilerVisibleProperty Include="SarifMetricsEnabled" />
    <CompilerVisibleProperty Include="AltCoverEnabled" />
  </ItemGroup>

  <!-- Test assemblies that should receive instrumented runtime binaries for AltCover coverage -->
  <!-- Identity = runtime assembly name prefix (e.g. Rca.Core), metadata TestProjectName = test project folder name -->
  <ItemGroup>
    <AltCoverInstrumentedTestAssembly Include="Rca.Contracts">
      <TestProjectName>Rca.Contracts.Tests</TestProjectName>
    </AltCoverInstrumentedTestAssembly>
    <AltCoverInstrumentedTestAssembly Include="Rca.Core">
      <TestProjectName>Rca.Core.Tests</TestProjectName>
    </AltCoverInstrumentedTestAssembly>
    <AltCoverInstrumentedTestAssembly Include="Rca.Loader">
      <TestProjectName>Rca.Loader.Tests</TestProjectName>
    </AltCoverInstrumentedTestAssembly>
    <AltCoverInstrumentedTestAssembly Include="Rca.Network">
      <TestProjectName>Rca.Network.Tests</TestProjectName>
    </AltCoverInstrumentedTestAssembly>
    <AltCoverInstrumentedTestAssembly Include="Rca.UI">
      <TestProjectName>Rca.UI.Tests</TestProjectName>
    </AltCoverInstrumentedTestAssembly>
  </ItemGroup>
</Project>
