<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- 
    Common.targets - Shared build configuration for all RCA projects
    
    This file provides:
    - Common property definitions (Revit paths, deploy locations)
    - Shared Revit API references (RevitAPI.dll, RevitAPIUI.dll)
    - IronPython content files for projects that need them
    - Addin file generation for Loader project
    - Initial Loader deployment to Revit addins directory
    
    All projects should import this file to ensure consistent configuration.
  -->

  <!-- Common configuration properties -->
  <PropertyGroup>
    <!-- Revit version targeted by the plugin (2026) -->
    <RcaRevitVersion Condition="'$(RcaRevitVersion)' == ''">2026</RcaRevitVersion>
    
    <!-- Path to Revit API libraries (RevitAPI.dll, RevitAPIUI.dll) -->
    <RcaRevitLibsPath Condition="'$(RcaRevitLibsPath)' == ''">$(SolutionDir)libs\Revit\$(RcaRevitVersion)</RcaRevitLibsPath>
    
    <!-- Revit addins directory where .addin file is deployed -->
    <RcaRevitAddinsDir Condition="'$(RcaRevitAddinsDir)' == ''">$(APPDATA)\Autodesk\Revit\Addins\$(RcaRevitVersion)</RcaRevitAddinsDir>
    
    <!-- RCA-specific subdirectory in Revit addins folder (contains Rca.Loader.dll) -->
    <RcaAddinDir Condition="'$(RcaAddinDir)' == ''">$(RcaRevitAddinsDir)\Rca</RcaAddinDir>
    
    <!-- Root directory for all runtime deployments (timestamped folders created here) -->
    <RcaRuntimeDeployRoot Condition="'$(RcaRuntimeDeployRoot)' == ''">$(LocalAppData)\RCA\Runtime</RcaRuntimeDeployRoot>
    
    <!-- Hot-reload deploy directory with timestamp (set in Directory.Build.props for consistency across projects) -->
    <RcaHotReloadDeployDir>$(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp)</RcaHotReloadDeployDir>
    
    <!-- Unified output path for all build artifacts (bin directory at solution root) -->
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''">$(SolutionDir)bin\</BaseOutputPath>
  </PropertyGroup>

  <!-- Common Revit API references for all projects that need Revit API access -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RcaRevitLibsPath)\RevitAPI.dll</HintPath>
      <!-- Private=False prevents copying to output dir (Revit provides these at runtime) -->
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RcaRevitLibsPath)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- 
    Common IronPython content files for projects that execute Python code
    Projects must set IncludeIronPythonContent=true to include these files
  -->
  <ItemGroup Condition="'$(IncludeIronPythonContent)' == 'true'">
    <!-- IronPython runtime DLLs from NuGet packages -->
    <Content Include="$(UserProfile)\.nuget\packages\ironpython\3.4.2\lib\net8.0\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Python standard library (Lib folder) -->
    <Content Include="$(UserProfile)\.nuget\packages\ironpython.stdlib\3.4.2\contentFiles\any\any\Lib\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- DynamicLanguageRuntime dependencies -->
    <Content Include="$(UserProfile)\.nuget\packages\dynamiclanguageruntime\1.3.5\lib\net8.0\Microsoft.Scripting.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(UserProfile)\.nuget\packages\dynamiclanguageruntime\1.3.5\lib\net8.0\Microsoft.Dynamic.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 
    Generate Rca.addin file to Revit addins directory
    This target only runs for the Loader project (GenerateRcaAddinFile=true)
    Creates the XML manifest that tells Revit how to load the RCA plugin
  -->
  <Target Name="GenerateRcaAddinFile" AfterTargets="Build" Condition="'$(GenerateRcaAddinFile)' == 'true'">
    <PropertyGroup>
      <AddinXmlContent>
        <![CDATA[<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
  <AddIn Type="Application">
    <Name>Revit Chat Assistant</Name>
    <Assembly>Rca\Rca.Loader.dll</Assembly>
    <FullClassName>Rca.Loader.LoaderApp</FullClassName>
    <AddInId>69632772-0062-48b8-a275-c42ae27ec46e</AddInId>
    <VendorId>RCA</VendorId>
    <VendorDescription>Revit Chat Assistant, https://github.com/baidakovil</VendorDescription>
  </AddIn>
</RevitAddIns>]]>
      </AddinXmlContent>
    </PropertyGroup>
    
    <!-- Create Rca subdirectory if it doesn't exist -->
    <MakeDir Directories="$(RcaAddinDir)" Condition="!Exists('$(RcaAddinDir)')" />
    
    <!-- Write the .addin manifest file -->
    <WriteLinesToFile File="$(RcaRevitAddinsDir)\Rca.addin"
                      Lines="$(AddinXmlContent)"
                      Overwrite="true" />
                      
    <Message Text="Generated Rca.addin at $(RcaRevitAddinsDir)" Importance="high" />
  </Target>

  <!-- 
    Copy merged Loader DLL to Revit addins directory during initial setup ONLY
    This target only runs if:
    - IsLoaderProject=true (only for Rca.Loader project)
    - Rca.Loader.dll does NOT already exist in the target directory
    
    Why initial setup only?
    During hot-reload development, the Loader assembly in Revit addins dir should NOT be
    automatically updated by the build (requires Revit restart). Updates are handled by
    the explicit restart workflow via RestartManager.
  -->
  <Target Name="InitialSetupCopyToRevitAddins" AfterTargets="Build" 
          Condition="'$(IsLoaderProject)' == 'true' AND !Exists('$(RcaAddinDir)\Rca.Loader.dll')">
    
    <!-- Create Rca subdirectory if it doesn't exist -->
    <MakeDir Directories="$(RcaAddinDir)" Condition="!Exists('$(RcaAddinDir)')" />
    
    <!-- Copy the merged Loader DLL to the Revit addins directory -->
    <Copy
      SourceFiles="$(OutputPath)Rca.Loader.dll"
      DestinationFolder="$(RcaAddinDir)"
      SkipUnchangedFiles="true" />
      
    <Message Text="Performed initial setup - copied Loader assembly to $(RcaAddinDir)" 
             Importance="High" />
  </Target>
</Project>
