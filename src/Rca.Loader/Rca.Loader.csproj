<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>Rca.Loader</AssemblyName>
    <RootNamespace>Rca.Loader</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Identify this as the Loader project for special handling -->
    <IsLoaderProject>true</IsLoaderProject>
    <!-- Generate addin file on build -->
    <GenerateRcaAddinFile>true</GenerateRcaAddinFile>
    <!-- Suppress Revit API reference warnings -->
    <NoWarn>$(NoWarn);MSB3245;MSB3243</NoWarn>
    <!-- We will not generate assembly attributes before merge; attributes are injected post-merge by AttributeInjector -->
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <!-- Ensure timestamp exists: use provided RcaHotReloadTimestamp or default to current UTC timestamp -->
  <PropertyGroup>
    <RcaHotReloadTimestamp Condition="'$(RcaHotReloadTimestamp)' == ''">$([System.DateTime]::UtcNow.ToString("yyyyMMdd_HHmmss"))</RcaHotReloadTimestamp>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Rca.Loader.Contracts\Rca.Loader.Contracts.csproj" />
    <ProjectReference Include="..\Rca.Contracts\Rca.Contracts.csproj" />
    <ProjectReference Include="..\Rca.Logging.Contracts\Rca.Logging.Contracts.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <!-- Explicit references to Revit API DLLs with absolute paths -->
    <Reference Include="RevitAPI">
      <HintPath>$(MSBuildProjectDirectory)\..\..\libs\Revit\2026\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(MSBuildProjectDirectory)\..\..\libs\Revit\2026\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.0.1" />
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <PackageReference Include="ilrepack" Version="2.0.34" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>
  
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  
  <ItemGroup>
    <EmbeddedResource Include="Resources\\*.png" />
  </ItemGroup>

  <!-- Exclude BuildTasks folder from the main project's compile items -->
  <ItemGroup>
    <Compile Remove="BuildTasks\\**\\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="BuildTasks\\MergeAssembliesTask.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="BuildTasks\\Rca.Loader.Tasks.csproj" />
  </ItemGroup>

  <!-- ILRepack target to merge assemblies using Exec (external ILRepack.exe) -->
  <Target Name="RepackLoader" AfterTargets="Build">
    <Message Text="Merging Rca.Loader.dll and Rca.Loader.Contracts.dll" Importance="High" />

    <!-- Create list of reference libraries -->
    <ItemGroup>
      <ReferenceDlls Include="$(MSBuildProjectDirectory)\..\..\libs\Revit\2026\RevitAPI.dll" />
      <ReferenceDlls Include="$(MSBuildProjectDirectory)\..\..\libs\Revit\2026\RevitAPIUI.dll" />
    </ItemGroup>

    <!-- Prepare temp directory for ILRepack lib option -->
    <PropertyGroup>
      <IlRepackTempDir>$(IntermediateOutputPath)ilrepack_$(MSBuildProjectName)</IlRepackTempDir>
      <IlRepackPath>$(USERPROFILE)\.nuget\packages\ilrepack\2.0.34\tools\ILRepack.exe</IlRepackPath>
      <MergedOutput>$(TargetDir)Rca.Loader.Merged.dll</MergedOutput>
    </PropertyGroup>

    <MakeDir Directories="$(IlRepackTempDir)" />

    <!-- Copy reference DLLs to temp dir to allow ILRepack to resolve them -->
    <Copy SourceFiles="@(ReferenceDlls)" DestinationFolder="$(IlRepackTempDir)" SkipUnchangedFiles="false" />

    <!-- Fail early if ILRepack not found -->
    <Error Condition="!Exists('$(IlRepackPath)')" Text="ILRepack not found at: $(IlRepackPath)" />

    <!-- Run ILRepack to create merged assembly; ensure attributes are preserved from the compiled assembly -->
    <Exec Command="&quot;$(IlRepackPath)&quot; /out:&quot;$(MergedOutput)&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)Rca.Loader.Contracts.dll&quot; /xmldocs /copyattrs /parallel /internalize /lib:&quot;$(IlRepackTempDir)&quot;" />

    <!-- Replace the original with the merged file -->
    <Copy SourceFiles="$(MergedOutput)" DestinationFiles="$(TargetPath)" />

    <!-- Delete the Contracts DLL and the temporary merged file -->
    <Delete Files="$(TargetDir)Rca.Loader.Contracts.dll;$(MergedOutput)" />

    <!-- Clean up temp dir -->
    <RemoveDir Directories="$(IlRepackTempDir)" />

    <Message Text="ILRepack completed successfully - Using merged assembly" Importance="High" />

    <!-- Build AttributeInjector and run the built exe to inject metadata -->
    <PropertyGroup>
      <AttributeInjectorProject>$(SolutionDir)src\Tools\AttributeInjector\AttributeInjector.csproj</AttributeInjectorProject>
      <AttributeInjectorExe>$(SolutionDir)src\Tools\AttributeInjector\bin\$(Configuration)\net8.0\AttributeInjector.exe</AttributeInjectorExe>
    </PropertyGroup>
    <Exec Command="dotnet build &quot;$(AttributeInjectorProject)&quot; -c $(Configuration)" />
    <Error Condition="!Exists('$(AttributeInjectorExe)')" Text="AttributeInjector executable not found at $(AttributeInjectorExe)" />
    <Exec Command="&quot;$(AttributeInjectorExe)&quot; &quot;$(TargetPath)&quot; &quot;$(RcaHotReloadTimestamp)&quot; &quot;$(RcaLoaderSourceHash)&quot;" ContinueOnError="false" />
  </Target>
  
  <!-- Generate loader source hash before compile (do not generate assembly attributes yet) -->
  <PropertyGroup>
    <SourceHashProject>$(SolutionDir)src\Tools\SourceHashGenerator\SourceHashGenerator.csproj</SourceHashProject>
    <SourceHashExe>$(SolutionDir)src\Tools\SourceHashGenerator\bin\$(Configuration)\net8.0\SourceHashGenerator.exe</SourceHashExe>
    <SourceRootList>$(MSBuildProjectDirectory);$(SolutionDir)src\Rca.Loader.Contracts</SourceRootList>
    <SourceHashIntermediate>$(IntermediateOutputPath)source-hash.loader.txt</SourceHashIntermediate>
  </PropertyGroup>

  <Target Name="GenerateLoaderSourceHashAndMetadata" BeforeTargets="CoreCompile">
    <Exec Command="dotnet build &quot;$(SourceHashProject)&quot; -c $(Configuration)" />
    <Exec Command="&quot;$(SourceHashExe)&quot; --roots &quot;$(SourceRootList)&quot; --out &quot;$(SourceHashIntermediate)&quot;" ContinueOnError="true" />

    <ReadLinesFromFile File="$(SourceHashIntermediate)" ContinueOnError="true">
      <Output TaskParameter="Lines" ItemName="LoaderSourceHashLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <RcaLoaderSourceHash>%(LoaderSourceHashLines.Identity)</RcaLoaderSourceHash>
    </PropertyGroup>

    <!-- Generate assembly metadata source file to embed into assembly -->
    <ItemGroup>
      <RcaLoaderAssemblyMetadataLines Include="[assembly: System.Reflection.AssemblyMetadata(&quot;SourceHash&quot;, &quot;$(RcaLoaderSourceHash)&quot;)]" />
      <RcaLoaderAssemblyMetadataLines Include="[assembly: System.Reflection.AssemblyMetadata(&quot;DeployFolder&quot;, &quot;$(RcaHotReloadTimestamp)&quot;)]" />
      <RcaLoaderAssemblyMetadataLines Include="[assembly: System.Reflection.AssemblyInformationalVersion(&quot;Hash: $(RcaLoaderSourceHash), Folder: $(RcaHotReloadTimestamp)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)RcaLoaderAssemblyMetadata.cs" Overwrite="true" Lines="@(RcaLoaderAssemblyMetadataLines)" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)RcaLoaderAssemblyMetadata.cs" />
    </ItemGroup>
  </Target>
  
  <!-- Deploy merged Loader assembly to hot-reload temp folder (same as Runtime) -->
  <Target Name="DeployLoaderToTemp" AfterTargets="RepackLoader">
    <PropertyGroup>
      <RuntimeDeployDir>$(RcaHotReloadDeployDir)</RuntimeDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(RuntimeDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />
    <Message Text="Copied Loader assembly to hot-reload directory: $(RuntimeDeployDir)" Importance="High" />
    <Message Text="Deployed Loader assembly to hot-reload directory: $(RuntimeDeployDir)" Importance="High" />

    <!-- Write loader version info file using previously computed short hash -->
    <PropertyGroup>
      <LoaderVersionFile>$(RuntimeDeployDir)\HashLoader - $(RcaLoaderSourceHash).txt</LoaderVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(LoaderVersionFile)" Lines="$(RcaLoaderSourceHash)" Overwrite="true" />

  </Target>
  
  <Import Project="..\..\build\Common.targets" />
</Project>
