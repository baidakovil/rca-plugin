    </PropertyGroup>
    <MakeDir Directories="$(RevitAddinDir)" Condition="!Exists('$(RevitAddinDir)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevitAddinDir)" SkipUnchangedFiles="false" />
    <Message Text="Deployed Loader assembly to Revit addins directory: $(RevitAddinDir)" Importance="High" />
  </Target>
  -->
  
  <Import Project="..\..\build\Common.targets" />
</Project>
