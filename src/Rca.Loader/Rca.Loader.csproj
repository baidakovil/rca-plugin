<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>Rca.Loader</AssemblyName>
    <RootNamespace>Rca.Loader</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rca.Loader.Contracts\Rca.Loader.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(SolutionDir)libs\Revit\2026\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(SolutionDir)libs\Revit\2026\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- Try both approaches: explicit and wildcard -->
    <EmbeddedResource Include="Resources\*.png" />
    <EmbeddedResource Include="Resources\OpenAssistant16.png">
      <LogicalName>Rca.Loader.Resources.OpenAssistant16.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\OpenAssistant32.png">
      <LogicalName>Rca.Loader.Resources.OpenAssistant32.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\ReloadRuntime16.png">
      <LogicalName>Rca.Loader.Resources.ReloadRuntime16.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Resources\ReloadRuntime32.png">
      <LogicalName>Rca.Loader.Resources.ReloadRuntime32.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
