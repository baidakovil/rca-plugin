<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>Rca.Loader</AssemblyName>
    <RootNamespace>Rca.Loader</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    
    <!-- Identify this as the Loader project for special handling in Common.targets -->
    <IsLoaderProject>true</IsLoaderProject>
    
    <!-- Generate .addin file on build -->
    <GenerateRcaAddinFile>true</GenerateRcaAddinFile>
    
    <!-- Suppress Revit API reference warnings (RevitAPI.dll is not copied to output) -->
    <NoWarn>$(NoWarn);MSB3245;MSB3243</NoWarn>
    
    <!-- 
      Disable auto-generation of AssemblyInformationalVersionAttribute.
      AttributeInjector will inject all assembly attributes post-ILRepack merge.
    -->
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>

  <!-- 
    Ensure shared hot-reload timestamp is available.
    This timestamp serves as the deploy folder name and is embedded into assembly metadata.
    Fallback to UTC timestamp if not set by Directory.Build.props.
  -->
  <PropertyGroup>
    <RcaHotReloadTimestamp Condition="'$(RcaHotReloadTimestamp)' == ''">$([System.DateTime]::UtcNow.ToString("yyyyMMdd_HHmmss"))</RcaHotReloadTimestamp>
  </PropertyGroup>
  
  <!-- Project references for Loader dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\Rca.Loader.Contracts\Rca.Loader.Contracts.csproj" />
    <ProjectReference Include="..\Rca.Contracts\Rca.Contracts.csproj" />
    <ProjectReference Include="..\Rca.Logging.Contracts\Rca.Logging.Contracts.csproj" />
  </ItemGroup>
  
  <!-- NuGet package references -->
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.0.1" />
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
    <PackageReference Include="ilrepack" Version="2.0.34" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>
  
  <!-- Windows Desktop framework reference for WPF support -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>
  
  <!-- Embedded resources (images, icons, etc.) -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\\*.png" />
  </ItemGroup>

  <!-- 
    Exclude BuildTasks folder from main project compilation.
    BuildTasks is a separate sub-project for MSBuild custom tasks.
  -->
  <ItemGroup>
    <Compile Remove="BuildTasks\\**\\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="BuildTasks\\MergeAssembliesTask.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="BuildTasks\\Rca.Loader.Tasks.csproj" />
  </ItemGroup>

  <!-- 
    Property definitions for build tools (SourceHashGenerator and AttributeInjector).
    These tools are compiled as needed during the build process.
  -->
  <PropertyGroup>
    <SourceHashProject>$(SolutionDir)src\Tools\SourceHashGenerator\SourceHashGenerator.csproj</SourceHashProject>
    <SourceHashExe>$(SolutionDir)src\Tools\SourceHashGenerator\bin\$(Configuration)\net8.0\SourceHashGenerator.exe</SourceHashExe>
    <AttributeInjectorProject>$(SolutionDir)src\Tools\AttributeInjector\AttributeInjector.csproj</AttributeInjectorProject>
    <AttributeInjectorExe>$(SolutionDir)src\Tools\AttributeInjector\bin\$(Configuration)\net8.0\AttributeInjector.exe</AttributeInjectorExe>
  </PropertyGroup>

  <!-- 
    Property definitions for source hash generation.
    SourceRootList: directories to scan for source files (Loader + Loader.Contracts).
    SourceHashIntermediateFile: intermediate output file for computed hash.
  -->
  <PropertyGroup>
    <SourceRootList>$(MSBuildProjectDirectory);$(SolutionDir)src\Rca.Loader.Contracts</SourceRootList>
    <SourceHashIntermediateFile>$(IntermediateOutputPath)source-hash-loader.txt</SourceHashIntermediateFile>
  </PropertyGroup>

  <!-- 
    Target: BuildSourceHashGenerator
    
    Compiles SourceHashGenerator tool only if it's outdated or doesn't exist.
    This provides incremental compilation - tool is not rebuilt on every build.
    Uses file modification time (Ticks) for comparison to ensure numeric comparison.
  -->
  <Target Name="BuildSourceHashGenerator" BeforeTargets="GenerateLoaderSourceHash">
    <PropertyGroup>
      <SourceHashProjectModTime>$([System.IO.File]::GetLastWriteTime('$(SourceHashProject)').Ticks)</SourceHashProjectModTime>
      <SourceHashExeModTime Condition="Exists('$(SourceHashExe)')">$([System.IO.File]::GetLastWriteTime('$(SourceHashExe)').Ticks)</SourceHashExeModTime>
      <SourceHashExeModTime Condition="!Exists('$(SourceHashExe)')">0</SourceHashExeModTime>
    </PropertyGroup>
    
    <MSBuild Projects="$(SourceHashProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             Condition="'$(SourceHashProjectModTime)' &gt; '$(SourceHashExeModTime)'" />
  </Target>

  <!-- 
    Target: GenerateLoaderSourceHash
    
    Generates source hash for Loader + Loader.Contracts source code.
    Hash is written to intermediate file and exposed as RcaLoaderSourceHash property.
    
    Why BeforeTargets="CoreCompile"?
    We need the hash value available during compilation, but we do NOT inject it
    as source code anymore - AttributeInjector handles all metadata injection post-merge.
  -->
  <Target Name="GenerateLoaderSourceHash" BeforeTargets="CoreCompile" DependsOnTargets="BuildSourceHashGenerator">
    <!-- Execute SourceHashGenerator tool to compute hash -->
    <Exec Command="&quot;$(SourceHashExe)&quot; --roots &quot;$(SourceRootList)&quot; --out &quot;$(SourceHashIntermediateFile)&quot;" 
          ContinueOnError="true" />

    <!-- Read computed hash from intermediate file -->
    <ReadLinesFromFile File="$(SourceHashIntermediateFile)" ContinueOnError="true">
      <Output TaskParameter="Lines" ItemName="LoaderSourceHashLines" />
    </ReadLinesFromFile>

    <!-- Expose hash as MSBuild property for use in later targets -->
    <PropertyGroup>
      <RcaLoaderSourceHash>%(LoaderSourceHashLines.Identity)</RcaLoaderSourceHash>
    </PropertyGroup>
    
    <Message Text="Loader source hash generated: $(RcaLoaderSourceHash)" Importance="High" />
  </Target>

  <!-- 
    Target: RepackLoader
    
    Merges Rca.Loader.dll and Rca.Loader.Contracts.dll into a single assembly using ILRepack.
    
    Steps:
    1. Create temporary directory for Revit API references (required by ILRepack /lib option)
    2. Copy RevitAPI.dll and RevitAPIUI.dll to temp dir
    3. Create internalize exclude list to keep Rca.Loader.Contracts types public
       (Runtime needs access to contract interfaces like IRuntimePanelFactory)
    4. Run ILRepack to merge assemblies
    5. Replace original Rca.Loader.dll with merged version
    6. Delete separate Rca.Loader.Contracts.dll (now internalized in merged assembly)
    7. Clean up temporary directory
  -->
  <Target Name="RepackLoader" AfterTargets="Build">
    <Message Text="Merging Rca.Loader.dll and Rca.Loader.Contracts.dll using ILRepack" Importance="High" />

    <!-- Define reference DLLs needed for ILRepack assembly resolution -->
    <ItemGroup>
      <ReferenceDlls Include="$(RcaRevitLibsPath)\RevitAPI.dll" />
      <ReferenceDlls Include="$(RcaRevitLibsPath)\RevitAPIUI.dll" />
    </ItemGroup>

    <!-- Property group for ILRepack operation -->
    <PropertyGroup>
      <!-- Temporary directory for reference assemblies -->
      <IlRepackTempDir>$(IntermediateOutputPath)ilrepack_$(MSBuildProjectName)</IlRepackTempDir>
      
      <!-- Path to ILRepack executable from NuGet package -->
      <IlRePackPath>$(USERPROFILE)\.nuget\packages\ilrepack\2.0.34\tools\ILRepack.exe</IlRePackPath>
      
      <!-- Output path for merged assembly -->
      <MergedOutput>$(TargetDir)Rca.Loader.Merged.dll</MergedOutput>
      
      <!-- File containing list of types to exclude from internalization -->
      <InternalizeExcludeFile>$(IntermediateOutputPath)internalize-exclude.txt</InternalizeExcludeFile>
    </PropertyGroup>

    <!-- Create temporary directory for reference assemblies -->
    <MakeDir Directories="$(IlRepackTempDir)" />

    <!-- 
      Copy Revit API DLLs to temp directory.
      ILRepack needs these to resolve type references, but won't merge them.
    -->
    <Copy SourceFiles="@(ReferenceDlls)" DestinationFolder="$(IlRepackTempDir)" SkipUnchangedFiles="false" />

    <!-- 
      Create internalize exclude list.
      Rca.Loader.Contracts types must remain public so Runtime can access them
      across AssemblyLoadContext boundary (e.g., IRuntimePanelFactory interface).
    -->
    <WriteLinesToFile File="$(InternalizeExcludeFile)" Lines="Rca.Loader.Contracts" Overwrite="true" />

    <!-- Fail early if ILRepack executable not found -->
    <Error Condition="!Exists('$(IlRepackPath)')" Text="ILRepack not found at: $(IlRepackPath)" />

    <!-- 
      Execute ILRepack to merge assemblies.
      Options:
      - /out: output merged assembly path
      - /xmldocs: merge XML documentation files
      - /copyattrs: copy assembly-level attributes (will be replaced by AttributeInjector)
      - /parallel: enable parallel processing
      - /internalize: make all types internal except those in exclude file
      - /lib: directory to search for reference assemblies
    -->
    <Exec Command="&quot;$(IlRepackPath)&quot; /out:&quot;$(MergedOutput)&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)Rca.Loader.Contracts.dll&quot; /xmldocs /copyattrs /parallel /internalize:&quot;$(InternalizeExcludeFile)&quot; /lib:&quot;$(IlRepackTempDir)&quot;" />

    <!-- Replace original assembly with merged version -->
    <Copy SourceFiles="$(MergedOutput)" DestinationFiles="$(TargetPath)" />

    <!-- Delete separate Contracts DLL and temporary merged file -->
    <Delete Files="$(TargetDir)Rca.Loader.Contracts.dll;$(MergedOutput)" />

    <!-- Clean up temporary directory -->
    <RemoveDir Directories="$(IlRepackTempDir)" />

    <Message Text="ILRepack completed successfully - merged assembly created" Importance="High" />
  </Target>

  <!-- 
    Target: BuildAttributeInjector
    
    Compiles AttributeInjector tool only if it's outdated or doesn't exist.
    This provides incremental compilation - tool is not rebuilt on every build.
    Uses file modification time (Ticks) for comparison to ensure numeric comparison.
  -->
  <Target Name="BuildAttributeInjector" AfterTargets="RepackLoader">
    <PropertyGroup>
      <AttributeInjectorProjectModTime>$([System.IO.File]::GetLastWriteTime('$(AttributeInjectorProject)').Ticks)</AttributeInjectorProjectModTime>
      <AttributeInjectorExeModTime Condition="Exists('$(AttributeInjectorExe)')">$([System.IO.File]::GetLastWriteTime('$(AttributeInjectorExe)').Ticks)</AttributeInjectorExeModTime>
      <AttributeInjectorExeModTime Condition="!Exists('$(AttributeInjectorExe)')">0</AttributeInjectorExeModTime>
    </PropertyGroup>
    
    <MSBuild Projects="$(AttributeInjectorProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             Condition="'$(AttributeInjectorProjectModTime)' &gt; '$(AttributeInjectorExeModTime)'" />
  </Target>

  <!-- 
    Target: InjectLoaderAttributes
    
    Injects assembly metadata attributes into the merged Loader assembly using AttributeInjector.
    
    Why post-ILRepack injection?
    ILRepack's /copyattrs doesn't preserve custom AssemblyMetadata attributes correctly.
    AttributeInjector uses Mono.Cecil to inject attributes directly into the IL after merge.
    
    Injected attributes:
    - AssemblyMetadata("DeployFolder", timestamp)
    - AssemblyMetadata("SourceHash", hash)
    - AssemblyInformationalVersion (visible in Windows Explorer as Product Version)
  -->
  <Target Name="InjectLoaderAttributes" AfterTargets="BuildAttributeInjector" DependsOnTargets="BuildAttributeInjector">
    <!-- Fail if AttributeInjector executable not found -->
    <Error Condition="!Exists('$(AttributeInjectorExe)')" 
           Text="AttributeInjector executable not found at $(AttributeInjectorExe)" />
    
    <!-- 
      Execute AttributeInjector.
      Arguments:
      1. Target assembly path (merged Rca.Loader.dll)
      2. Deploy folder timestamp (embedded as metadata for correlation)
      3. Source hash (embedded as metadata for version tracking)
    -->
    <Exec Command="&quot;$(AttributeInjectorExe)&quot; &quot;$(TargetPath)&quot; &quot;$(RcaHotReloadTimestamp)&quot; &quot;$(RcaLoaderSourceHash)&quot;" 
          ContinueOnError="false" />
    
    <Message Text="Assembly attributes injected successfully" Importance="High" />
  </Target>
  
  <!-- 
    Target: DeployLoaderToTemp
    
    Deploys merged Loader assembly to hot-reload directory (same timestamped folder as Runtime).
    Creates version tracking file for debugging and validation.
    
    Why deploy Loader to hot-reload directory?
    - Runtime needs access to Loader.Contracts types (merged into Rca.Loader.dll)
    - Allows validation of loader/runtime version compatibility
    - Supports assembly status tracking in AssemblyStatusManager
  -->
  <Target Name="DeployLoaderToTemp" AfterTargets="InjectLoaderAttributes">
    <PropertyGroup>
      <RuntimeDeployDir>$(RcaHotReloadDeployDir)</RuntimeDeployDir>
    </PropertyGroup>
    
    <!-- Create deploy directory if it doesn't exist -->
    <MakeDir Directories="$(RuntimeDeployDir)" />
    
    <!-- Copy merged Loader assembly to deploy directory -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />
    
    <Message Text="Copied Loader assembly to hot-reload directory: $(RuntimeDeployDir)" Importance="High" />

    <!-- 
      Write loader version file with PascalCase naming convention.
      Format: SourceHash-Loader-{hash}.txt
      Content: source hash value
      
      Purpose: Allows build system and AssemblyStatusManager to quickly identify
      deployed loader version without parsing assembly metadata.
    -->
    <PropertyGroup>
      <LoaderVersionFile>$(RuntimeDeployDir)\SourceHash-Loader-$(RcaLoaderSourceHash).txt</LoaderVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(LoaderVersionFile)" Lines="$(RcaLoaderSourceHash)" Overwrite="true" />
    
    <Message Text="Loader deployment completed successfully" Importance="High" />
  </Target>
  
  <!-- Import common build configuration (Revit paths, API references, etc.) -->
  <Import Project="..\..\build\Common.targets" />
</Project>
