<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>Rca.Runtime</AssemblyName>
    <RootNamespace>Rca.Runtime</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rca.Core\Rca.Core.csproj" />
    <ProjectReference Include="..\Rca.UI\Rca.UI.csproj" />
    <ProjectReference Include="..\Rca.Network\Rca.Network.csproj" />
    <ProjectReference Include="..\Rca.Contracts\Rca.Contracts.csproj" />
    <ProjectReference Include="..\Rca.Logging.Contracts\Rca.Logging.Contracts.csproj" />
  </ItemGroup>

  <!-- Reference the merged Rca.Loader.dll (built by Loader project) -->
  <ItemGroup>
    <Reference Include="Rca.Loader">
      <HintPath>..\Rca.Loader\bin\$(Configuration)\net8.0-windows\Rca.Loader.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!-- Ensure Loader is built before Runtime (for merged Rca.Loader.dll reference) -->
  <ItemGroup>
    <ProjectReference Include="..\Rca.Loader\Rca.Loader.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(SolutionDir)libs\Revit\2026\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(SolutionDir)libs\Revit\2026\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ilrepack" Version="2.0.34" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <IncludeIronPythonContent>true</IncludeIronPythonContent>
  </PropertyGroup>

  <PropertyGroup>
    <SourceHashProject>$(SolutionDir)src\Tools\SourceHashGenerator\SourceHashGenerator.csproj</SourceHashProject>
    <SourceHashExe>$(SolutionDir)src\Tools\SourceHashGenerator\bin\$(Configuration)\net8.0\SourceHashGenerator.exe</SourceHashExe>
    <SourceRootList>$(MSBuildProjectDirectory);$(SolutionDir)src\Rca.Core;$(SolutionDir)src\Rca.UI;$(SolutionDir)src\Rca.Network;$(SolutionDir)src\Rca.Contracts</SourceRootList>
    <SourceHashIntermediate>$(IntermediateOutputPath)source-hash.runtime.txt</SourceHashIntermediate>
  </PropertyGroup>

  <Target Name="GenerateSourceHashAndMetadata" BeforeTargets="CoreCompile">
    <Exec Command="dotnet build &quot;$(SourceHashProject)&quot; -c $(Configuration)" />
    <Exec Command="&quot;$(SourceHashExe)&quot; --roots &quot;$(SourceRootList)&quot; --out &quot;$(SourceHashIntermediate)&quot;" />

    <ReadLinesFromFile File="$(SourceHashIntermediate)">
      <Output TaskParameter="Lines" ItemName="SourceHashLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <RcaSourceHash>%(SourceHashLines.Identity)</RcaSourceHash>
    </PropertyGroup>

    <ItemGroup>
      <RcaAssemblyMetadataLines Include="[assembly: System.Reflection.AssemblyMetadata(&quot;SourceHash&quot;, &quot;$(RcaSourceHash)&quot;)]" />
      <RcaAssemblyMetadataLines Include="[assembly: System.Reflection.AssemblyMetadata(&quot;DeployFolder&quot;, &quot;$(RcaHotReloadTimestamp)&quot;)]" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)RcaAssemblyMetadata.cs" Overwrite="true" Lines="@(RcaAssemblyMetadataLines)" />

    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)RcaAssemblyMetadata.cs" />
    </ItemGroup>
  </Target>

  <Target Name="RepackRuntime" AfterTargets="Build">
    <PropertyGroup>
      <IlRepackExe>$(UserProfile)\.nuget\packages\ilrepack\2.0.34\tools\ILRepack.exe</IlRepackExe>
    </PropertyGroup>
    <ItemGroup>
      <InputAssemblies Include="$(TargetDir)Rca.Core.dll" />
      <InputAssemblies Include="$(TargetDir)Rca.UI.dll" />
      <InputAssemblies Include="$(TargetDir)Rca.Network.dll" />
      <InputAssemblies Include="$(TargetDir)Rca.Contracts.dll" />
      <InputAssemblies Include="$(TargetPath)" />
    </ItemGroup>
    <Message Text="ILRepack runtime assemblies -> Rca.Runtime.dll" Importance="High" />
    <Exec Command="&quot;$(IlRepackExe)&quot; /lib:$(TargetDir) /copyattrs /parallel /internalize /xmldocs /out:$(TargetDir)Rca.Runtime.dll @(InputAssemblies-&gt;'&quot;%(Identity)&quot;',' ')" />

    <PropertyGroup>
      <AttributeInjectorProject>$(SolutionDir)src\Tools\AttributeInjector\AttributeInjector.csproj</AttributeInjectorProject>
      <AttributeInjectorExe>$(SolutionDir)src\Tools\AttributeInjector\bin\$(Configuration)\net8.0\AttributeInjector.exe</AttributeInjectorExe>
      <RevitLibsDir>$(SolutionDir)libs\Revit\2026</RevitLibsDir>
    </PropertyGroup>
    <Exec Command="dotnet build &quot;$(AttributeInjectorProject)&quot; -c $(Configuration)" />
    <Error Condition="!Exists('$(AttributeInjectorExe)')" Text="AttributeInjector executable not found at $(AttributeInjectorExe)" />
    <Exec Command="&quot;$(AttributeInjectorExe)&quot; &quot;$(TargetDir)Rca.Runtime.dll&quot; &quot;$(RcaHotReloadTimestamp)&quot; &quot;$(RcaSourceHash)&quot; &quot;$(RevitLibsDir)&quot;" ContinueOnError="true" />
    <Message Condition="'$(MSBuildLastTaskResult)' == 'false'" Text="WARNING: AttributeInjector failed." Importance="High" />
  </Target>

  <Target Name="DeployRuntime" AfterTargets="RepackRuntime">
    <PropertyGroup>
      <RuntimeDeployDir>$(RcaHotReloadDeployDir)</RuntimeDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(RuntimeDeployDir)" />
    <ItemGroup>
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Runtime.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Core.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.UI.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Network.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Contracts.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)IronPython*.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Microsoft.Scripting.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Microsoft.Dynamic.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Logging.Contracts.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Loader.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDeployFiles)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <LibFiles Include="$(TargetDir)Lib\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibFiles)" DestinationFiles="@(LibFiles-&gt;'$(RuntimeDeployDir)\Lib\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="@(LibFiles)!=''" />
    <PropertyGroup>
      <RuntimeVersionFile>$(RuntimeDeployDir)\HashRuntime - $(RcaSourceHash).txt</RuntimeVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(RuntimeVersionFile)" Lines="$(RcaSourceHash)" Overwrite="true" />
    <Message Text="Deployed Runtime to hot-reload directory: $(RuntimeDeployDir)" Importance="High" />
  </Target>

  <PropertyGroup>
    <HotReloadNotify Condition="'$(HotReloadNotify)' == ''">true</HotReloadNotify>
  </PropertyGroup>

  <Target Name="ReloadRuntime" AfterTargets="DeployRuntime" Condition="'$(HotReloadNotify)' == 'true'">
    <PropertyGroup>
      <PipeName>RCA_PIPE</PipeName>
      <RuntimeDeployDirEscaped>$([System.String]::Copy('$(RuntimeDeployDir)').Replace('\\','\\\\'))</RuntimeDeployDirEscaped>
      <PsHotReloadCmd>powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "try { $p = New-Object System.IO.Pipes.NamedPipeClientStream('.', '$(PipeName)', [System.IO.Pipes.PipeDirection]::InOut); $p.Connect(2000); $sw = New-Object System.IO.StreamWriter($p); $sw.AutoFlush = $true; $sr = New-Object System.IO.StreamReader($p); $msg = '{\"Command\":\"RELOAD_RUNTIME\", \"Payload\":\"$(RuntimeDeployDirEscaped)\"}'; $sw.WriteLine($msg); $resp = $sr.ReadLine(); Write-Host 'HotReload response:' $resp; $p.Close() } catch { Write-Warning ('HotReload failed: ' + $_.Exception.Message) }"</PsHotReloadCmd>
    </PropertyGroup>
    <Message Text="Sending RELOAD_RUNTIME command to pipe server" Importance="High" />
    <Exec Command="$(PsHotReloadCmd)" IgnoreExitCode="true" />
  </Target>
  <Target Name="ReloadRuntimeDisabled" AfterTargets="DeployRuntime" Condition="'$(HotReloadNotify)' != 'true'">
    <Message Text="HotReload notification disabled" Importance="Low" />
  </Target>

  <Import Project="..\..\build\Common.targets" />
</Project>
