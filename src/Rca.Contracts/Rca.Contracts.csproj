<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>Rca.Contracts</AssemblyName>
    <RootNamespace>Rca.Contracts</RootNamespace>
	<PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- No Revit API references needed for Contracts project -->

  <ItemGroup>
    <Compile Remove="Generated\**\*.cs" />
  </ItemGroup>

  <!-- Ensure source generator project is attached as an analyzer so generated metadata is available -->
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)src\Tools\Rca.BuildMetadata.Generator\Rca.BuildMetadata.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
