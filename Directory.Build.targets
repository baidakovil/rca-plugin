<Project>
  <PropertyGroup>
    <SourceHashProject>$(SolutionDir)src\Tools\SourceHashGenerator\SourceHashGenerator.csproj</SourceHashProject>
    <SourceHashExe>$(SolutionDir)src\Tools\SourceHashGenerator\bin\$(Configuration)\net8.0\SourceHashGenerator.exe</SourceHashExe>

    <RcaLoaderRoots>$(SolutionDir)src\Rca.Loader;$(SolutionDir)src\Rca.Loader.Contracts;$(SolutionDir)src\Rca.Logging.Contracts</RcaLoaderRoots>
    <RcaRuntimeRoots>$(SolutionDir)src\Rca.Core;$(SolutionDir)src\Rca.Runtime;$(SolutionDir)src\Rca.Network;$(SolutionDir)src\Rca.UI;$(SolutionDir)src\Rca.Contracts</RcaRuntimeRoots>

    <!-- Only two artifacts kept here, overwritten each build -->
    <RcaArtifactsDir>$(SolutionDir)build\artifacts\hashes</RcaArtifactsDir>
    <RcaLoaderHashFile>$(RcaArtifactsDir)\loader.txt</RcaLoaderHashFile>
    <RcaRuntimeHashFile>$(RcaArtifactsDir)\runtime.txt</RcaRuntimeHashFile>
  </PropertyGroup>

  <Target Name="BuildSourceHashGenerator" BeforeTargets="GenerateHash">
    <PropertyGroup>
      <SourceHashProjectModTime>$([System.IO.File]::GetLastWriteTime('$(SourceHashProject)').Ticks)</SourceHashProjectModTime>
      <SourceHashExeModTime Condition="Exists('$(SourceHashExe)')">$([System.IO.File]::GetLastWriteTime('$(SourceHashExe)').Ticks)</SourceHashExeModTime>
      <SourceHashExeModTime Condition="!Exists('$(SourceHashExe)')">0</SourceHashExeModTime>
    </PropertyGroup>
    <MSBuild Projects="$(SourceHashProject)" Targets="Build" Properties="Configuration=$(Configuration)" Condition="'$(SourceHashProjectModTime)' &gt; '$(SourceHashExeModTime)' or !Exists('$(SourceHashExe)')" />
  </Target>

  <!-- Compute hashes once per build using a TEMP lock keyed by RcaHotReloadTimestamp. No extra files in artifacts dir. -->
  <Target Name="GenerateHash" BeforeTargets="CoreCompile" DependsOnTargets="BuildSourceHashGenerator">
    <Message Text="GenerateHash: ensure hashes exist for this build" Importance="Low" />

    <MakeDir Directories="$(RcaArtifactsDir)" />

    <PropertyGroup>
      <PsCmd>&quot;$m = New-Object System.Threading.Mutex($false, 'Global\RCA_GenerateHash'); try { $null = $m.WaitOne(); $stamp = '$(RcaHotReloadTimestamp)'; if ([string]::IsNullOrWhiteSpace($stamp)) { $stamp = [DateTime]::UtcNow.ToString('yyyyMMdd_HHmmss') }; $lock = Join-Path $env:TEMP ('RCA_GenerateHash_' + $stamp + '.lock'); if (Test-Path $lock) { exit 0 } else { New-Item -ItemType File -Path $lock -Force | Out-Null }; &amp; '&quot;$(SourceHashExe)&quot;' --roots '&quot;$(RcaLoaderRoots)&quot;' --out '&quot;$(RcaLoaderHashFile)&quot;'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; &amp; '&quot;$(SourceHashExe)&quot;' --roots '&quot;$(RcaRuntimeRoots)&quot;' --out '&quot;$(RcaRuntimeHashFile)&quot;'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE } } finally { try { $m.ReleaseMutex() | Out-Null } catch {} }&quot;</PsCmd>
    </PropertyGroup>

    <Exec Command='powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command $(PsCmd)' />

    <Error Condition="!Exists('$(RcaLoaderHashFile)')" Text="GenerateHash failed: $(RcaLoaderHashFile) not created" />
    <Error Condition="!Exists('$(RcaRuntimeHashFile)')" Text="GenerateHash failed: $(RcaRuntimeHashFile) not created" />
  </Target>

  <PropertyGroup>
    <IsLoaderGroupProject>false</IsLoaderGroupProject>
    <IsRuntimeGroupProject>false</IsRuntimeGroupProject>
    <IsLoaderGroupProject Condition="'$(MSBuildProjectName)' == 'Rca.Loader' or '$(MSBuildProjectName)' == 'Rca.Loader.Contracts' or '$(MSBuildProjectName)' == 'Rca.Logging.Contracts'">true</IsLoaderGroupProject>
    <IsRuntimeGroupProject Condition="'$(MSBuildProjectName)' == 'Rca.Core' or '$(MSBuildProjectName)' == 'Rca.Runtime' or '$(MSBuildProjectName)' == 'Rca.Network' or '$(MSBuildProjectName)' == 'Rca.UI' or '$(MSBuildProjectName)' == 'Rca.Contracts'">true</IsRuntimeGroupProject>
  </PropertyGroup>

  <Target Name="EmitAssemblyMetadataSource" Condition="'$(IsLoaderGroupProject)' == 'true' or '$(IsRuntimeGroupProject)' == 'true'" BeforeTargets="CoreCompile" DependsOnTargets="GenerateHash">
    <PropertyGroup>
      <MetadataSource>$(IntermediateOutputPath)Rca.AssemblyMetadata.g.cs</MetadataSource>
    </PropertyGroup>

    <ReadLinesFromFile File="$(RcaLoaderHashFile)">
      <Output TaskParameter="Lines" ItemName="_LoaderHashLines" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(RcaRuntimeHashFile)">
      <Output TaskParameter="Lines" ItemName="_RuntimeHashLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <LoaderHash>%( _LoaderHashLines.Identity )</LoaderHash>
      <RuntimeHash>%( _RuntimeHashLines.Identity )</RuntimeHash>
      <ThisSourceHash Condition="'$(IsLoaderGroupProject)' == 'true'">$(LoaderHash)</ThisSourceHash>
      <ThisSourceHash Condition="'$(IsRuntimeGroupProject)' == 'true' and '$(ThisSourceHash)' == ''">$(RuntimeHash)</ThisSourceHash>
    </PropertyGroup>

    <Error Condition="'$(ThisSourceHash)' == ''" Text="EmitAssemblyMetadataSource failed: missing SourceHash for project $(MSBuildProjectName)" />

    <ItemGroup>
      <_MetadataLines Include="// &lt;auto-generated/&gt;" />
      <_MetadataLines Include='[assembly: System.Reflection.AssemblyMetadata(&quot;SourceHash&quot;, &quot;$(ThisSourceHash)&quot;)]' />
      <_MetadataLines Include='[assembly: System.Reflection.AssemblyMetadata(&quot;DeployFolder&quot;, &quot;$(RcaHotReloadTimestamp)&quot;)]' />
      <_MetadataLines Include="namespace Rca.Generated { internal static class __RcaAssemblyMetadataAnchor { } }" />
    </ItemGroup>

    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(MetadataSource)" Lines="@(_MetadataLines)" Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(MetadataSource)" Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="DeployLoaderGroup" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'Rca.Loader'">
    <PropertyGroup>
      <RuntimeDeployDir>$(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp)</RuntimeDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(RuntimeDeployDir)" />
    <ItemGroup>
      <LoaderDeployFiles Include="$(TargetDir)Rca.Loader.dll" />
      <LoaderDeployFiles Include="$(TargetDir)Rca.Loader.Contracts.dll" />
      <LoaderDeployFiles Include="$(TargetDir)Rca.Logging.Contracts.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LoaderDeployFiles)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />
    <PropertyGroup>
      <LoaderVersionFile>$(RuntimeDeployDir)\SourceHash-Loader-$(ThisSourceHash).txt</LoaderVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(LoaderVersionFile)" Lines="$(ThisSourceHash)" Overwrite="true" />
    <Message Text="Loader group deployed to $(RuntimeDeployDir)" Importance="High" />
  </Target>

  <Target Name="DeployRuntimeGroup" AfterTargets="Build" Condition="'$(MSBuildProjectName)' == 'Rca.Runtime'">
    <PropertyGroup>
      <RuntimeDeployDir>$(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp)</RuntimeDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(RuntimeDeployDir)" />
    <ItemGroup>
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Runtime.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Core.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Network.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.UI.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Contracts.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)IronPython*.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Microsoft.Scripting.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Microsoft.Dynamic.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDeployFiles)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />
    <ItemGroup>
      <LibFiles Include="$(TargetDir)Lib\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibFiles)" DestinationFiles="@(LibFiles-&gt;'$(RuntimeDeployDir)\Lib\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="@(LibFiles)!=''" />
    <PropertyGroup>
      <RuntimeVersionFile>$(RuntimeDeployDir)\SourceHash-Runtime-$(ThisSourceHash).txt</RuntimeVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(RuntimeVersionFile)" Lines="$(ThisSourceHash)" Overwrite="true" />
    <Message Text="Runtime group deployed to $(RuntimeDeployDir)" Importance="High" />
  </Target>

  <PropertyGroup>
    <HotReloadNotify Condition="'$(HotReloadNotify)' == ''">true</HotReloadNotify>
  </PropertyGroup>

  <Target Name="NotifyBuildCompleted" AfterTargets="DeployRuntimeGroup" Condition="'$(MSBuildProjectName)' == 'Rca.Runtime' and '$(HotReloadNotify)' == 'true'">
    <PropertyGroup>
      <PipeName>RCA_PIPE</PipeName>
      <PsNotifyCmd>powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "try { $p = New-Object System.IO.Pipes.NamedPipeClientStream('.', '$(PipeName)', [System.IO.Pipes.PipeDirection]::InOut); $p.Connect(3000); $sw = New-Object System.IO.StreamWriter($p); $sw.AutoFlush = $true; $sr = New-Object System.IO.StreamReader($p); $msg = '{\"Command\":\"BUILD_COMPLETED\",\"Payload\":\"\"}'; $sw.WriteLine($msg); $resp = $sr.ReadLine(); Write-Host 'Build notification response:' $resp; $p.Close() } catch { Write-Warning ('Build notification failed: ' + $_.Exception.Message) }"</PsNotifyCmd>
    </PropertyGroup>
    <Message Text="Notifying Revit addin about completed build" Importance="High" />
    <Exec Command="$(PsNotifyCmd)" IgnoreExitCode="true" />
  </Target>
</Project>
