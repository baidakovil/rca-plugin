<Project>
  <PropertyGroup>
    <!-- Ensure SolutionDir is available even when building individual projects -->
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>

    <!-- Generator project and executable -->
    <SourceHashProject>$(SolutionDir)src\Tools\SourceHashGenerator\SourceHashGenerator.csproj</SourceHashProject>
    <SourceHashExe>$(SolutionDir)src\Tools\SourceHashGenerator\bin\$(Configuration)\net8.0\SourceHashGenerator.exe</SourceHashExe>

    <!-- Source roots -->
    <RcaLoaderRoots>$(SolutionDir)src\Rca.Loader;$(SolutionDir)src\Rca.Loader.Contracts;$(SolutionDir)src\Rca.Logging.Contracts</RcaLoaderRoots>
    <RcaRuntimeRoots>$(SolutionDir)src\Rca.Core;$(SolutionDir)src\Rca.Runtime;$(SolutionDir)src\Rca.Network;$(SolutionDir)src\Rca.UI;$(SolutionDir)src\Rca.Contracts</RcaRuntimeRoots>

    <!-- Default deploy root under LocalApplicationData if not provided -->
    <RcaRuntimeDeployRoot Condition="'$(RcaRuntimeDeployRoot)' == ''">$(LOCALAPPDATA)\RCA\Runtime</RcaRuntimeDeployRoot>

    <!-- Timestamp file moved to deploy root so hashes live only under deploy timestamp folder -->
    <RcaTimestampFile>$(RcaRuntimeDeployRoot)\Timestamp.txt</RcaTimestampFile>

    <!-- Sticky timestamp config -->
    <RcaStickyStampSeconds Condition="'$(RcaStickyStampSeconds)' == ''">60</RcaStickyStampSeconds>
    <!-- Set to true/1 to force a fresh timestamp, ignoring stickiness -->
    <RcaForceNewStamp Condition="'$(RcaForceNewStamp)' == ''">false</RcaForceNewStamp>
  </PropertyGroup>

  <!-- Ensure a single shared timestamp per real build with sticky TTL and force override -->
  <Target Name="EnsureRcaTimestamp" Condition="'$(DesignTimeBuild)' != 'true'" BeforeTargets="Build">
    <!-- Create deploy root where timestamp and marker files will be stored -->
    <MakeDir Directories="$(RcaRuntimeDeployRoot)" />
    <Exec Command='powershell -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(SolutionDir)build\Scripts\EnsureRcaStamp.ps1&quot; -TargetPath &quot;$(RcaTimestampFile)&quot; -TtlSec &quot;$(RcaStickyStampSeconds)&quot; -ForceStr &quot;$(RcaForceNewStamp)&quot;' />

    <ReadLinesFromFile File="$(RcaTimestampFile)">
      <Output TaskParameter="Lines" ItemName="_StampLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <RcaHotReloadTimestamp>@(_StampLines)</RcaHotReloadTimestamp>
    </PropertyGroup>
    <Message Text="EnsureRcaTimestamp: $(RcaHotReloadTimestamp) (TTL=$(RcaStickyStampSeconds)s, Force=$(RcaForceNewStamp))" Importance="Low" />
  </Target>

  <!-- Ensure SourceHashGenerator -->
  <Target Name="BuildSourceHashGenerator" BeforeTargets="GenerateHash" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' != 'SourceHashGenerator'">
    <PropertyGroup>
      <SourceHashProjectModTime>$([System.IO.File]::GetLastWriteTime('$(SourceHashProject)').Ticks)</SourceHashProjectModTime>
      <SourceHashExeModTime Condition="Exists('$(SourceHashExe)')">$([System.IO.File]::GetLastWriteTime('$(SourceHashExe)').Ticks)</SourceHashExeModTime>
      <SourceHashExeModTime Condition="!Exists('$(SourceHashExe)')">0</SourceHashExeModTime>
    </PropertyGroup>
    <!-- Always build SourceHashGenerator to ensure exe is up-to-date with source changes -->
    <MSBuild Projects="$(SourceHashProject)" Targets="Build" Properties="Configuration=$(Configuration)" Condition="'$(SourceHashProjectModTime)' &gt; '$(SourceHashExeModTime)' or !Exists('$(SourceHashExe)')" />
  </Target>

  <!-- Ensure runtime deploy folder exists before generating hashes -->
  <Target Name="EnsureRuntimeDeployFolder" Condition="'$(DesignTimeBuild)' != 'true'" BeforeTargets="GenerateHash">
    <PropertyGroup>
      <_RuntimeDeployDir>$(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp)</_RuntimeDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(_RuntimeDeployDir)" />
    <Message Text="EnsureRuntimeDeployFolder: created $(_RuntimeDeployDir)" Importance="Low" />
  </Target>

  <!-- Compute hashes. Generator writes marker files and outputs into deploy/<timestamp> only -->
  <Target Name="GenerateHash" BeforeTargets="CoreCompile" DependsOnTargets="EnsureRcaTimestamp;EnsureRuntimeDeployFolder;BuildSourceHashGenerator" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' != 'SourceHashGenerator'">
    <Message Text="GenerateHash: compute loader/runtime hashes (deploy-only)" Importance="Low" />

    <!-- Call generator for Loader group: generator will create marker files SourceHash-Loader-<hash>.txt in deploy timestamp folder -->
    <Exec Command='&quot;$(SourceHashExe)&quot; --roots &quot;$(RcaLoaderRoots)&quot; --group Loader --timestamp &quot;$(RcaHotReloadTimestamp)&quot; --deployDir &quot;$(RcaRuntimeDeployRoot)&quot; --wait-ms 600000' />

    <!-- Call generator for Runtime group: generator will create marker files SourceHash-Runtime-<hash>.txt in deploy timestamp folder -->
    <Exec Command='&quot;$(SourceHashExe)&quot; --roots &quot;$(RcaRuntimeRoots)&quot; --group Runtime --timestamp &quot;$(RcaHotReloadTimestamp)&quot; --deployDir &quot;$(RcaRuntimeDeployRoot)&quot; --wait-ms 600000' />

    <!-- Generator creates marker files in $(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp); no duplicate out files are produced anymore -->
  </Target>

  <!-- Project grouping flags -->
  <PropertyGroup>
    <IsLoaderGroupProject>false</IsLoaderGroupProject>
    <IsRuntimeGroupProject>false</IsRuntimeGroupProject>
    <IsLoaderGroupProject Condition="'$(MSBuildProjectName)' == 'Rca.Loader' or '$(MSBuildProjectName)' == 'Rca.Loader.Contracts' or '$(MSBuildProjectName)' == 'Rca.Logging.Contracts'">true</IsLoaderGroupProject>
    <IsRuntimeGroupProject Condition="'$(MSBuildProjectName)' == 'Rca.Core' or '$(MSBuildProjectName)' == 'Rca.Runtime' or '$(MSBuildProjectName)' == 'Rca.Network' or '$(MSBuildProjectName)' == 'Rca.UI' or '$(MSBuildProjectName)' == 'Rca.Contracts'">true</IsRuntimeGroupProject>
  </PropertyGroup>

  <!-- Emit assembly metadata (real builds only) - read hashes from deploy folder only -->
  <Target Name="EmitAssemblyMetadataSource" Condition="('$(DesignTimeBuild)' != 'true') and ('$(IsLoaderGroupProject)' == 'true' or '$(IsRuntimeGroupProject)' == 'true')" BeforeTargets="CoreCompile" DependsOnTargets="GenerateHash">
    <PropertyGroup>
      <MetadataSource>$(IntermediateOutputPath)Rca.AssemblyMetadata.g.cs</MetadataSource>
    </PropertyGroup>

    <ItemGroup>
      <_LoaderMarker Include="$(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp)\SourceHash-Loader-*.txt" />
      <_RuntimeMarker Include="$(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp)\SourceHash-Runtime-*.txt" />
    </ItemGroup>

    <ReadLinesFromFile File="@(_LoaderMarker)" Condition="'@(_LoaderMarker)' != ''">
      <Output TaskParameter="Lines" ItemName="_LoaderHashLines" />
    </ReadLinesFromFile>

    <ReadLinesFromFile File="@(_RuntimeMarker)" Condition="'@(_RuntimeMarker)' != ''">
      <Output TaskParameter="Lines" ItemName="_RuntimeHashLines" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <LoaderHash>%( _LoaderHashLines.Identity )</LoaderHash>
      <RuntimeHash>%( _RuntimeHashLines.Identity )</RuntimeHash>
      <ThisSourceHash Condition="'$(IsLoaderGroupProject)' == 'true'">$(LoaderHash)</ThisSourceHash>
      <ThisSourceHash Condition="'$(IsRuntimeGroupProject)' == 'true' and '$(ThisSourceHash)' == ''">$(RuntimeHash)</ThisSourceHash>
    </PropertyGroup>

    <Error Condition="'$(ThisSourceHash)' == ''" Text="EmitAssemblyMetadataSource failed: missing SourceHash for project $(MSBuildProjectName)" />

    <ItemGroup>
      <_MetadataLines Include="// &lt;auto-generated/&gt;" />
      <_MetadataLines Include='[assembly: System.Reflection.AssemblyMetadata(&quot;SourceHash&quot;, &quot;$(ThisSourceHash)&quot;)]' />
      <_MetadataLines Include='[assembly: System.Reflection.AssemblyMetadata(&quot;DeployFolder&quot;, &quot;$(RcaHotReloadTimestamp)&quot;)]' />
      <_MetadataLines Include="namespace Rca.Generated { internal static class __RcaAssemblyMetadataAnchor { } }" />
    </ItemGroup>

    <WriteLinesToFile File="$(MetadataSource)" Lines="@(_MetadataLines)" Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(MetadataSource)" Visible="false" />
    </ItemGroup>
  </Target>

  <!-- Deploy groups (real builds only) -->
  <Target Name="DeployLoaderGroup" AfterTargets="Build" DependsOnTargets="EnsureRcaTimestamp" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Rca.Loader'">
    <PropertyGroup>
      <RuntimeDeployDir>$(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp)</RuntimeDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(RuntimeDeployDir)" />
    <ItemGroup>
      <LoaderDeployFiles Include="$(TargetDir)Rca.Loader.dll" />
      <LoaderDeployFiles Include="$(TargetDir)Rca.Loader.Contracts.dll" />
      <LoaderDeployFiles Include="$(TargetDir)Rca.Logging.Contracts.dll" />
      <!-- Ensure deps.json is deployed next to Loader for Default ALC probing -->
      <LoaderDeployFiles Include="$(TargetDir)Rca.Loader.deps.json" Condition="Exists('$(TargetDir)Rca.Loader.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(LoaderDeployFiles)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />

    <!-- Copy PDBs next to the DLLs -->
    <ItemGroup>
      <LoaderDeployPdbs Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(LoaderDeployPdbs)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" Condition="@(LoaderDeployPdbs)!=''" />

    <!-- Marker file is created by SourceHashGenerator in deploy folder -->

    <Message Text="Loader group deployed to $(RuntimeDeployDir)" Importance="High" />
  </Target>

  <Target Name="DeployRuntimeGroup" AfterTargets="Build" DependsOnTargets="EnsureRcaTimestamp" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Rca.Runtime'">
    <PropertyGroup>
      <RuntimeDeployDir>$(RcaRuntimeDeployRoot)\$(RcaHotReloadTimestamp)</RuntimeDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(RuntimeDeployDir)" />
    <ItemGroup>
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Runtime.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Core.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Network.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.UI.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Rca.Contracts.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)IronPython*.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Microsoft.Scripting.dll" />
      <RuntimeDeployFiles Include="$(TargetDir)Microsoft.Dynamic.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDeployFiles)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" />

    <!-- Copy PDBs next to the DLLs -->
    <ItemGroup>
      <RuntimeDeployPdbs Include="$(TargetDir)*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDeployPdbs)" DestinationFolder="$(RuntimeDeployDir)" SkipUnchangedFiles="false" Condition="@(RuntimeDeployPdbs)!=''" />

    <ItemGroup>
      <LibFiles Include="$(TargetDir)Lib\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibFiles)" DestinationFiles="@(LibFiles-&gt;'$(RuntimeDeployDir)\Lib\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="@(LibFiles)!=''" />

    <!-- Marker file is created by SourceHashGenerator in deploy folder -->

    <Message Text="Runtime group deployed to $(RuntimeDeployDir)" Importance="High" />
  </Target>

  <!-- Optional: build notification -->
  <PropertyGroup>
    <HotReloadNotify Condition="'$(HotReloadNotify)' == ''">true</HotReloadNotify>
  </PropertyGroup>
  <Target Name="NotifyBuildCompleted" AfterTargets="DeployRuntimeGroup" Condition="'$(DesignTimeBuild)' != 'true' and '$(MSBuildProjectName)' == 'Rca.Runtime' and '$(HotReloadNotify)' == 'true'">
    <PropertyGroup>
      <PipeName>RCA_PIPE</PipeName>
      <PsNotifyCmd>powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "try { $p = New-Object System.IO.Pipes.NamedPipeClientStream('.', '$(PipeName)', [System.IO.Pipes.PipeDirection]::InOut); $p.Connect(3000); $sw = New-Object System.IO.StreamWriter($p); $sw.AutoFlush = $true; $sr = New-Object System.IO.StreamReader($p); $msg = '{\"Command\":\"BUILD_COMPLETED\",\"Payload\":\"\"}'; $sw.WriteLine($msg); $resp = $sr.ReadLine(); Write-Host 'Build notification response:' $resp; $p.Close() } catch { Write-Warning ('Build notification failed: ' + $_.Exception.Message) }"</PsNotifyCmd>
    </PropertyGroup>
    <Message Text="Notifying Revit addin about completed build" Importance="High" />
    <Exec Command="$(PsNotifyCmd)" IgnoreExitCode="true" />
  </Target>
</Project>
