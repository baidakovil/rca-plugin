{
  "general": {
    "runScripts": true,
    "aggregateAfterScripts": true,
    "verbosity": "normal",
    "timeoutSeconds": 900,
    "logTruncationLimit": 4000
  },
  "paths": {
    "metricsDir": "build/Metrics",
    "report": "build/Metrics/Report/MetricsReport.g.json",
    "readReport": "build/Metrics/Report/MetricsReport.g.json",
    "baseline": "build/MetricsTemp/MetricsBaseline.g.json",
    "baselineStoragePath": "%LOCALAPPDATA%/RCA/Metrics",
    "suppressedSymbols": "build/MetricsTemp/SuppressedSymbols.g.json",
    "thresholds": "build/Metrics/MetricsRules/MetricsReporterThresholds.json",
    "solutionDirectory": ".",
    "sourceCodeFolders": [
      "src",
      "tests"
    ],
    "opencover": [
      "build/MetricsTemp/CoverageStorage.g.xml"
    ],
    "coverageHtmlDir": "build/Metrics/AltCover/html",
    "outputHtml": "build/Metrics/Report/MetricsReport.html",
    "roslyn": [
      "build/Metrics/Roslyn/SolutionMetrics.g.xml"
    ],
    "sarif": [
      "build/Metrics/Sarif/Rca.BuildMetadata.Generator.sarif",
      "build/Metrics/Sarif/Rca.BuildMetadata.Generator.Tests.sarif",
      "build/Metrics/Sarif/Rca.Contracts.sarif",
      "build/Metrics/Sarif/Rca.Contracts.Tests.sarif",
      "build/Metrics/Sarif/Rca.Core.sarif",
      "build/Metrics/Sarif/Rca.Core.Tests.sarif",
      "build/Metrics/Sarif/Rca.Integration.Revit.Tests.sarif",
      "build/Metrics/Sarif/Rca.Loader.Contracts.sarif",
      "build/Metrics/Sarif/Rca.Loader.sarif",
      "build/Metrics/Sarif/Rca.Loader.Tests.sarif",
      "build/Metrics/Sarif/Rca.Logging.Contracts.sarif",
      "build/Metrics/Sarif/Rca.Network.sarif",
      "build/Metrics/Sarif/Rca.Network.Tests.sarif",
      "build/Metrics/Sarif/Rca.Runtime.sarif",
      "build/Metrics/Sarif/Rca.TestAdapter.sarif",
      "build/Metrics/Sarif/Rca.UI.sarif",
      "build/Metrics/Sarif/Rca.UI.Tests.sarif"
    ],
    "excludedMembers": "*b__*,*d__*,<Create>*,*<Main>*,<Clone>$,ctor,cctor,MoveNext,SetStateMachine,MoveNextAsync,DisposeAsync,Deconstruct,GetHashCode,ToString,Equals,PrintMembers,op_Equality,op_Inequality,get_*,set_*,add_*,remove_*",
    "excludedTypes": "<>c,<-ctor>",
    "excludedAssemblies": "Tests",
    "solutionName": "rca-plugin",
    "excludeMethods": false,
    "excludeProperties": false,
    "excludeFields": true,
    "excludeEvents": false,
    "analyzeSuppressedSymbols": true,
    "replaceBaseline": false
  },
  "scripts": {
    "generate": [
      "build/Scripts/prepare-metrics.ps1"
    ],
    "read": {
      "byMetric": [
        {
          "metrics": [
            "OpenCoverBranchCoverage",
            "OpenCoverSequenceCoverage",
            "OpenCoverCyclomaticComplexity",
            "OpenCoverNPathComplexity"
          ],
          "path": "build/Scripts/collect-opencover.ps1"
        },
        {
          "metrics": [
            "RoslynCyclomaticComplexity",
            "RoslynClassCoupling",
            "RoslynMaintainabilityIndex",
            "RoslynDepthOfInheritance",
            "RoslynLinesOfCode",
            "RoslynSourceLines",
            "SarifCaRuleViolations",
            "SarifIdeRuleViolations",
            "Any"
          ],
          "path": "build/Scripts/prepare-metrics.ps1"
        }
      ]
    },
    "test": {
      "any": [
        "build/Scripts/prepare-metrics.ps1"
      ]
    }
  },
  "metricAliases": {
    "OpenCoverSequenceCoverage": [ "SequenceCoverage" ],
    "OpenCoverBranchCoverage": [ "BranchCoverage" ],
    "OpenCoverCyclomaticComplexity": [ "OpenCoverComplexity" ],
    "OpenCoverNPathComplexity": [ "NPath" ],
    "RoslynMaintainabilityIndex": [ "Maintainability"],
    "RoslynCyclomaticComplexity": [ "Complexity" ],
    "RoslynClassCoupling": [ "Coupling" ],
    "RoslynDepthOfInheritance": [ "Inheritance" ],
    "RoslynSourceLines": [ "SourceLines" ],
    "RoslynExecutableLines": [ "ExecutableLines" ],
    "SarifCaRuleViolations": [ "Ca" ],
    "SarifIdeRuleViolations": [ "Ide" ]
  }
}

