<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Disable timestamp file creation during metrics generation builds -->
    <!-- This prevents Timestamp.txt from being created when building with GenerateMetricsDashboard=true -->
    <RcaTimestampFile Condition="'$(GenerateMetricsDashboard)' == 'true'"></RcaTimestampFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tools\Rca.MetricsReporter\Rca.MetricsReporter.csproj" />
  </ItemGroup>

</Project>
