<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Enable coverage by default for unit tests; disable for integration tests project -->
    <CollectCoverage Condition="'$(MSBuildProjectName)' != 'Rca.Integration.Revit.Tests'">true</CollectCoverage>

    <!-- Instrument only product assemblies; exclude test assemblies -->
    <Include>[Rca.*]*</Include>
    <Exclude>[*.Tests]*</Exclude>

    <!-- Standard exclusions: autogenerated, compiler/coverage-ignored, obj/bin, designer -->
    <ExcludeByAttribute>GeneratedCodeAttribute;CompilerGeneratedAttribute;ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
    <ExcludeByFile>**/obj/**;**/bin/**;**/*.g.cs;**/*.g.i.cs;**/*.designer.cs;**/*AssemblyInfo*.cs;**/*.generated.cs;**/Rca.AssemblyMetadata.g.cs</ExcludeByFile>

    <!-- Coverlet output configuration: emit JSON (for tooling) and Cobertura (for HTML generation) -->
    <CoverletOutputFormat>json,cobertura</CoverletOutputFormat>
    <!-- Base output path; coverlet will append the appropriate extension per format -->
    <CoverletOutput>$(SolutionDir)build\coverage\$(MSBuildProjectName)\coverage</CoverletOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />

    <!-- Use MSBuild integration for coverlet -->
    <PackageReference Include="coverlet.msbuild" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
