<Project>
  <!-- Generate per-project and aggregated HTML coverage report for unit test projects -->
  <Target Name="GenerateCoverageHtml" AfterTargets="GenerateCoverageResult" Condition="'$(MSBuildProjectName)' != 'Rca.Integration.Revit.Tests' and '$(CollectCoverage)' == 'true'">
    <PropertyGroup>
      <CoverageOutDir>$(SolutionDir)build\coverage\$(MSBuildProjectName)</CoverageOutDir>
      <CoberturaReport>$(CoverageOutDir)\coverage.cobertura.xml</CoberturaReport>
      <HtmlReportDir>$(CoverageOutDir)\html</HtmlReportDir>
    </PropertyGroup>

    <!-- Ensure dotnet-reportgenerator-globaltool is available -->
    <Message Text="Ensuring reportgenerator tool is installed" Importance="Low" />
    <Exec Command="dotnet tool restore" />

    <!-- Convert cobertura to HTML for the current project -->
    <MakeDir Directories="$(HtmlReportDir)" />
    <Exec Command="dotnet tool run reportgenerator -reports:$(CoberturaReport) -targetdir:$(HtmlReportDir) -reporttypes:HtmlInline_AzurePipelines;TextSummary" />

    <Message Text="Coverage HTML generated at $(HtmlReportDir)" Importance="High" />
  </Target>

  <Target Name="GenerateAggregateCoverageHtml" AfterTargets="GenerateCoverageResult" Condition="'$(CollectCoverage)' == 'true'">
    <PropertyGroup>
      <AggregateReportsGlob>$(SolutionDir)build\coverage\**\coverage.cobertura.xml</AggregateReportsGlob>
      <AggregateOutDir>$(SolutionDir)build\coverage\summary\html</AggregateOutDir>
    </PropertyGroup>

    <ItemGroup>
      <_CoverageReports Include="$(AggregateReportsGlob)" />
    </ItemGroup>

    <!-- Only run aggregation if we have at least one report -->
    <Message Text="Found @( _CoverageReports->Count() ) coverage report(s) for aggregation" Importance="Low" />
    <MakeDir Directories="$(AggregateOutDir)" Condition="@( _CoverageReports ) != ''" />
    <Exec Condition="@( _CoverageReports ) != ''" Command="dotnet tool run reportgenerator -reports:@( _CoverageReports, ';' ) -targetdir:$(AggregateOutDir) -reporttypes:HtmlInline_AzurePipelines;TextSummary" />
    <Message Condition="@( _CoverageReports ) != ''" Text="Aggregate coverage HTML generated at $(AggregateOutDir)" Importance="High" />
  </Target>
</Project>
