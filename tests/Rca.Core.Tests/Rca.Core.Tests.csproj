<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Rca.Core.Tests</AssemblyName>
    <RootNamespace>Rca.Core.Tests</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Rca.Core/Rca.Core.csproj" />
    <ProjectReference Include="../../src/Rca.Contracts/Rca.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Rca.Loader\Rca.Loader.csproj" />
    <!-- Rca.Runtime reference removed to prevent AltCover instrumentation during test builds -->
    <!-- Tests only check metadata in already-deployed Rca.Runtime.dll, which doesn't require a project reference -->
  </ItemGroup>
  <!-- Use Update to avoid duplicate PackageReference items if defined in imported props/targets -->
  <ItemGroup>
    <PackageReference Update="NUnit" Version="4.0.1" />
    <PackageReference Update="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>
</Project>
