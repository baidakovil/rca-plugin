<Project>
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
    <!-- Shared timestamp for hot-reload deployments, set once per build -->
    <RcaHotReloadTimestamp Condition="'$(RcaHotReloadTimestamp)' == ''">$([System.DateTime]::Now.ToString("yyyyMMdd_HHmmss"))</RcaHotReloadTimestamp>
    <!-- Prevent SDK from auto-generating AssemblyInformationalVersion across projects to avoid duplicate attributes when we inject explicitly -->
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
  </PropertyGroup>
  
  <!-- Define properties in rca-plugin.sln.targets instead -->
</Project>
