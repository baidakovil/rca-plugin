{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug RCA Plugin Tests",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/tests/Rca.Loader.Tests/Rca.Loader.Tests.csproj",
        "--logger", "console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Debug Reload Trigger",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/net8.0-windows/RcaReloadTrigger.exe",
      "args": ["ping"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "externalTerminal"
    }
  ]
}